  // Sandbox: Snapshot + Recorder, kein echter REST-Aufruf
  startSandbox: function(fix){
    // 1. Echtes Modell sichern (deep clone, JSON-Vergleich später)
    this.snap = {
      stateJson: JSON.stringify(state),
      state: JSON.parse(JSON.stringify(state)),
      saveState: saveState,
      loadState: loadState
    };
    this.recorders = {saveCalls:0, loadCalls:0, lastSave:null};

    // 2. REST-Funktionen durch No-Op-Recorder ersetzen
    saveState = function(s){
      SELFTEST.recorders.saveCalls++;
      SELFTEST.recorders.lastSave = JSON.parse(JSON.stringify(s));
      return Promise.resolve(s);
    };
    loadState = function(){
      SELFTEST.recorders.loadCalls++;
      return Promise.resolve(JSON.parse(JSON.stringify(fix.state)));
    };

    // 3. Fixture als aktiven State installieren
    state = JSON.parse(JSON.stringify(fix.state));
  },

  endSandbox: function(){
    if(!this.snap)return;
    saveState = this.snap.saveState;
    loadState = this.snap.loadState;
    state = this.snap.state;
    var origJson = this.snap.stateJson;
    this.snap = null;
    // Re-Render mit echten Daten
    renderTable(state); renderBanner(state);
