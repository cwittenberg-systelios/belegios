/* Titelzeile (Screen) */
.bp-table thead tr.bp-titlebar-row th{background:rgb(151,19,33) !important;color:#fff !important;padding:10px 14px !important;vertical-align:middle !important;text-align:left !important;border:none !important;position:static !important;text-transform:none !important;letter-spacing:.01em !important;font-weight:400 !important}
.bp-titlebar-logo-wrap{float:right;margin-left:16px;line-height:0}
.bp-titlebar-logo{height:34px;display:block;filter:brightness(0) invert(1)}
.bp-titlebar-text{font-weight:700;font-size:22px;letter-spacing:.01em;line-height:1.15;margin:0;padding:0}
.bp-titlebar-meta{font-size:12px;opacity:.85;font-weight:400;margin-left:10px}
.bp-titlebar-buttons{display:inline-flex;gap:8px;margin-left:20px;vertical-align:middle}
.bp-tb-btn{background:#f4f5f7;color:#172b4d;border:1px solid #c1c7d0;font-size:12px;font-weight:400;padding:3px 8px;line-height:1.4;border-radius:3px;display:inline-flex;align-items:center;gap:5px;cursor:pointer}
