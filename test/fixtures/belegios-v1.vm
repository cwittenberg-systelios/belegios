// ── SPRINT 5: BANNER + QUICK-ACTIONS ─────────────────────────────────
function renderBanner(st){
  if(!st||!BANNER_EL)return;
  var today=sod(new Date());
  var urgent=(st.clients||[]).filter(function(c){
    return computeStatus(c,today).code===S.ENT;
  }).map(function(c){return {c:c,st:computeStatus(c,today)};});
  if(!urgent.length){BANNER_EL.innerHTML='';return;}
  var items=urgent.map(function(u){
    var tb=u.st.tageBis;
    var dayTxt=u.st.ueberfaellig?Math.abs(tb)+' T. \u00fcberf\u00e4llig!':tb+' T. bis Entscheidung';
    var cls='bp-banner-item'+(u.st.ueberfaellig?' bp-banner-overdue':'');
    var btns=canEdit?
      '<button class="bp-btn bp-btn-sm" data-bp-action="quick-verlaengern" data-bp-id="'+h(u.c.id)+'">Verl\u00e4ngerung</button>'+
      '<button class="bp-btn bp-btn-sm" data-bp-action="quick-entlassen" data-bp-id="'+h(u.c.id)+'">Entlassdatum festlegen</button>':'';
    return '<div class="'+cls+'"><span class="bp-banner-name">'+h(u.c.name)+'</span>'+
      '<span class="bp-banner-days">'+dayTxt+'</span>'+btns+'</div>';
  }).join('');
  BANNER_EL.innerHTML='<div class="bp-banner" role="alert" aria-live="polite">'+
    '<div class="bp-banner-title">Entscheidung erforderlich ('+urgent.length+')</div>'+
    items+'</div>';
}

