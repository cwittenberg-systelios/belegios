    COLS.map(function(col){
      var active = col.key===sortKey;
      var arrow = active ? (sortDir==='asc'?' \u25b2':' \u25bc') : '';
      var cls = 'bp-col-'+col.idx+(col.thCls?' '+col.thCls:'')+' bp-sortable'+(active?' bp-sorted':'');
      return '<th class="'+cls+'" data-bp-action="sort" data-bp-sortkey="'+col.key+'" title="Nach \u201e'+h(col.th)+'\u201c sortieren">'+col.th+arrow+'</th>';
    }).join('')+
    '<th class="bp-print-only bp-col-rm">R\u00fcckmeldung</th>'+
    '</tr></thead><tbody>'+rows+'</tbody></table></div>';
  disableScrollbar();
}

function disableScrollbar(){
  if(!window.AJS)return;
  window.AJS.toInit(function(){
    var $=window.AJS.$||window.jQuery; if(!$)return;
    $(TABLE_EL).find('.bp-table-wrap').closest('.table-wrap').removeClass('table-wrap');
  });
}

// ── SPRINT 3: AUFNAHME-MODAL ──────────────────────────────────────────
function thField(id, list, val){
  if(list&&list.length){
    // Bestehende Zuordnung darf nicht verloren gehen, wenn der Name (mehr)
    // nicht in der konfigurierten Liste steht (z.B. nach Aenderung in den
    // Einstellungen oder Umstieg Macro-Parameter -> Settings).
    var all=list.slice();
    if(val && all.indexOf(val)<0) all.push(val);
    var opts=['<option value="">\u2014 bitte w\u00e4hlen \u2014</option>'].concat(
      all.map(function(n){return '<option value="'+h(n)+'"'+(n===val?' selected':'')+'>'+h(n)+'</option>';}));
    return '<select id="'+id+'" class="bp-input">'+opts.join('')+'</select>';
  }
  return '<input type="text" id="'+id+'" class="bp-input" value="'+h(val||'')+'" placeholder="Name eingeben">';
}

function openAufnahmeModal(){
  var ac=getActiveCount(state.clients);
  var blocked=ac>=MAX_CAP;
  var warn=!blocked&&ac===WARN_CAP-1;
  var capMsg=blocked
    ?'<div class="bp-alert bp-alert-error">Maximale Gruppenkapazit\u00e4t erreicht ('+ac+'/'+MAX_CAP+'). Keine weitere Aufnahme m\u00f6glich.</div>'
    :warn?'<div class="bp-alert bp-alert-warn">Hinweis: Diese Aufnahme bringt die Gruppe auf '+WARN_CAP+' Klienten (Regelkapazit\u00e4t).</div>':'';
  MODAL_EL.innerHTML=
    '<div class="bp-overlay" data-bp-action="close-modal">'+
    '<div class="bp-modal" role="dialog" aria-modal="true">'+
    '<div class="bp-modal-header"><span class="bp-modal-title">Neue Aufnahme</span>'+
    '<button class="bp-modal-close" data-bp-action="close-modal">&times;</button></div>'+
    '<div class="bp-modal-body">'+capMsg+
    field('bp-a-name','Name','text','',true)+
    '<div class="bp-field"><label for="bp-a-aufnahme">Aufnahmedatum <span class="bp-req">*</span></label>'+
    '<input type="date" id="bp-a-aufnahme" class="bp-input" value="'+toISO(new Date())+'"'+dateAttrs('date')+' required></div>'+
    field('bp-a-kz-traeger','Kostentr\u00e4ger','text','PKV, BH, beides oder SZ',true)+
    field('bp-a-kz-bis','Kostenzusage bis','date','')+
    field('bp-a-kz-detail','Detail','text','z.B. PKV 6W / Beih. 4W')+
    '<div class="bp-field"><label>Wahlleistung</label>'+
    '<label class="bp-checkbox-label"><input type="checkbox" id="bp-a-goae"> Wahlleistung</label></div>'+
    '<div class="bp-field"><label>JuPsy</label>'+
    '<label class="bp-checkbox-label"><input type="checkbox" id="bp-a-jupsy"> JuPsy</label></div>'+
    '<div class="bp-field"><label for="bp-a-btv">Bezugsth. Verbal</label>'+thField('bp-a-btv',getThVerbalList(),'')+'</div>'+
    '<div class="bp-field"><label for="bp-a-btnv">Bezugsth. Non-Verbal</label>'+thField('bp-a-btnv',getThNvList(),'')+'</div>'+
    '</div>'+
    '<div class="bp-modal-footer">'+
    '<button class="bp-btn bp-btn-primary" data-bp-action="save-aufnahme"'+(blocked?' disabled':'')+'>Aufnehmen</button>'+
    '<button class="bp-btn" data-bp-action="close-modal">Abbrechen</button>'+
    '</div></div></div>';
  bindEsc();
  var el=document.getElementById('bp-a-name'); if(el)el.focus();
}

function field(id,lbl,type,ph,req){
  return '<div class="bp-field"><label for="'+id+'">'+lbl+(req?' <span class="bp-req">*</span>':'')+'</label>'+
    '<input type="'+type+'" id="'+id+'" class="bp-input" placeholder="'+h(ph||'')+'"'+dateAttrs(type)+(req?' required':'')+'>'+
    '</div>';
}

function handleAufnahme(){
  var name=val('bp-a-name'), auf=val('bp-a-aufnahme'), kzt=val('bp-a-kz-traeger');
  var kzb=val('bp-a-kz-bis'), kzd=val('bp-a-kz-detail');
  var goae=document.getElementById('bp-a-goae').checked;
  var jupsy=document.getElementById('bp-a-jupsy').checked;
  var btv=val('bp-a-btv'), btnv=val('bp-a-btnv');
  var err={};
  if(!name||name.length<2) err['bp-a-name']='Name erforderlich (min. 2 Zeichen)';
  if(!auf) err['bp-a-aufnahme']='Aufnahmedatum erforderlich';
  if(!kzt) err['bp-a-kz-traeger']='Kostentr\u00e4ger erforderlich';
  if(auf&&!dateInRange(auf)) err['bp-a-aufnahme']=dateRangeMsg();
  if(kzb&&!dateInRange(kzb)) err['bp-a-kz-bis']=dateRangeMsg();
  if(kzb&&auf&&kzb<auf) err['bp-a-kz-bis']='Kostenzusage-Datum muss nach Aufnahme liegen';
  if(Object.keys(err).length){showErr(err);return;}
  var _isFuture=(function(){var a=parseISO(auf); return a && a>sod(new Date());})();
  if(!_isFuture && getActiveCount(state.clients)>=MAX_CAP){setStatus('Maximale Kapazit\u00e4t erreicht.',true);return;}
  var nc={
    id:'c_'+Date.now().toString(36)+'_'+Math.random().toString(36).slice(2,6),
    name:name, aufnahmedatum:auf, kostenzusage_traeger:kzt,
    kostenzusage_bis:kzb||null, kostenzusage_detail:kzd,
    verlaengerung_bis:null, verlaengerung_status:'keine',
    goae:goae, jupsy:jupsy, bt_verbal:btv, bt_nonverbal:btnv,
    kein_ue_gruppe:false, entlassdatum:null,
    createdAt:new Date().toISOString()
  };
  state.clients.push(nc);
  renderTable(state); renderBanner(state); closeModal();
  saveState(state, {replay:replayAddClient(nc)}).then(function(){setStatus(name+' aufgenommen.');}).catch(function(e){
    state.clients.pop(); renderTable(state); renderBanner(state);
    setStatus('Fehler: '+e.message,true); openAufnahmeModal();
  });
}

