  /* Print-Only Elemente einblenden */
  .bp-print-only{display:table-cell !important}
  .bp-titlebar-row{display:table-row !important}

  /* Seite */
  @page{size:A4 landscape;margin:1.2cm 1cm}
  body{-webkit-print-color-adjust:exact;print-color-adjust:exact}

  /* Root */
  .bp-root{font-size:10px;color:#1a1a2e;font-family:Arial,Helvetica,sans-serif}

  /* Tabellen-Layout */
  .bp-table-wrap{max-height:none;overflow:visible;box-shadow:none}
  .bp-table{min-width:0;width:100%;border-collapse:collapse;border:none}

  /* Titel-Zeile (Print) */
