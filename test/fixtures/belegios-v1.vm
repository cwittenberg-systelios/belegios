      entlassdatum:'', kein_ue_gruppe:false, goae:false, bt_verbal:'', bt_nonverbal:''}];
    renderTable(state);
    var beforeCode = computeStatus(state.clients[0], fix.today).code;
    var verlCell = ROOT.querySelector('td[data-bp-field="verlaengerung_bis"][data-bp-id="'+ieId+'"]');
    t.log('Regression','Inline-Edit: verl_bis-Zelle im DOM', !!verlCell);
    if(verlCell){
      verlCell.dispatchEvent(new MouseEvent('click',{bubbles:true,cancelable:true}));
      var inp = ROOT.querySelector('input.bp-inline-input');
      t.log('Regression','Inline-Edit: date-Input erzeugt', !!inp && inp.type==='date');
      if(inp){
        inp.value = ddi(90);
        inp.dispatchEvent(new Event('change',{bubbles:true}));   // native Datumsauswahl
        var after = state.clients.find(function(x){return x.id===ieId;});
        t.assertEq('Regression','Inline-Edit change: verl_bis übernommen', after.verlaengerung_bis, ddi(90));
        t.assertEq('Regression','Inline-Edit change: Status neu berechnet → VZUB',
                   computeStatus(after, fix.today).code, 'verl_zu_beantragen');
        t.assertEq('Regression','Inline-Edit change: Status hat sich geändert',
                   computeStatus(after, fix.today).code !== beforeCode, true);
        t.assertEq('Regression','Inline-Edit change: Ü-Gruppe-Datum = verl_bis-6',
                   toISO(ueGruppe(after)), ddi(84));
      }
    }

    // [Quick-Verlängerung] Banner-Schnellaktion trägt nur das Datum ein → Status "VA stellen"
    // (verl_zu_beantragen), NICHT "VA beantragt". Der Antrag erfolgt erst per Badge-Klick.
    state = JSON.parse(JSON.stringify(fix.state));
    var qvId='qv_reg';
    state.clients=[{id:qvId, name:'QuickVerl', aufnahmedatum:ddi(-40), kostenzusage_traeger:'PKV',
      kostenzusage_detail:'', kostenzusage_bis:ddi(10), verlaengerung_bis:'', verlaengerung_status:'keine',
      entlassdatum:'', kein_ue_gruppe:false, goae:false, bt_verbal:'', bt_nonverbal:''}];
    renderTable(state); renderBanner(state);
    t.assertEq('Regression','Quick-Verl: Ausgangsstatus entscheidung_faellig',
               computeStatus(state.clients[0], fix.today).code, 'entscheidung_faellig');
    openQuickVerlaengernModal(qvId);
    var qvInp=document.getElementById('bp-qv-d');
    t.log('Regression','Quick-Verl: Datumsfeld im Modal', !!qvInp);
    if(qvInp){
      qvInp.value=ddi(60);
      handleQuickVerlaengern(qvId);
      var qvAfter=state.clients.find(function(x){return x.id===qvId;});
      t.assertEq('Regression','Quick-Verl: Status → VA stellen (zu_beantragen)', qvAfter.verlaengerung_status, 'zu_beantragen');
      t.assertEq('Regression','Quick-Verl: NICHT beantragt', qvAfter.verlaengerung_status!=='beantragt', true);
      t.assertEq('Regression','Quick-Verl: computeStatus → verl_zu_beantragen',
                 computeStatus(qvAfter, fix.today).code, 'verl_zu_beantragen');
      t.assertEq('Regression','Quick-Verl: Datum übernommen', qvAfter.verlaengerung_bis, ddi(60));
    }
    closeModal();

    // [Inline-Edit Plausibilität] Tippfehler-Jahr (0002) wird im in-place editing verworfen,
    // Feld bleibt unverändert. (Regression: '0002-07-10' kam genau über das Inline-Editing rein.)
    state = JSON.parse(JSON.stringify(fix.state));
    var drId='dr_inl';
    state.clients=[{id:drId, name:'Plausib', aufnahmedatum:ddi(-10), kostenzusage_traeger:'PKV',
      kostenzusage_detail:'', kostenzusage_bis:'', verlaengerung_bis:'', verlaengerung_status:'keine',
      entlassdatum:'', kein_ue_gruppe:false, goae:false, bt_verbal:'', bt_nonverbal:''}];
    renderTable(state);
    var edCell = ROOT.querySelector('td[data-bp-field="entlassdatum"][data-bp-id="'+drId+'"]');
    t.log('Regression','Inline-Plausib.: entlass-Zelle im DOM', !!edCell);
    if(edCell){
      edCell.dispatchEvent(new MouseEvent('click',{bubbles:true,cancelable:true}));
      var dInp = ROOT.querySelector('input.bp-inline-input');
      if(dInp){
        t.assertEq('Regression','Inline-Plausib.: min-Attribut gesetzt', dInp.min, dateMin());
        t.assertEq('Regression','Inline-Plausib.: max-Attribut gesetzt', dInp.max, dateMax());
        dInp.value = '0002-07-10';                       // Tippfehler-Jahr
        dInp.dispatchEvent(new Event('change',{bubbles:true}));
        var drAfter = state.clients.find(function(x){return x.id===drId;});
        t.assertEq('Regression','Inline-Plausib.: 0002-Jahr NICHT gespeichert', drAfter.entlassdatum, '');
      }
    }

    // [Wartung] Umschalter für entlassene (ausgeblendete) Klient:innen — Fixture enthält fx_entl.
    state = JSON.parse(JSON.stringify(fix.state));
    showEntlassen = false;
    renderTable(state);
    t.log('Regression','Wartung: Toggle „entlassen anzeigen" sichtbar', TABLE_EL.innerHTML.indexOf('toggle-entlassen')>=0);
    var entlRow = ROOT.querySelector('tr.bp-row-entlassen');
    t.log('Regression','Wartung: entlassene Zeile im DOM (CSS-versteckt)', !!entlRow);
    t.log('Regression','Wartung: entlassene Zeile hat Bearbeiten-Button',
          !!(entlRow && entlRow.querySelector('[data-bp-action="edit"]')));
    var tgl = ROOT.querySelector('[data-bp-action="toggle-entlassen"]');
    if(tgl){
      tgl.dispatchEvent(new MouseEvent('click',{bubbles:true,cancelable:true}));
      t.log('Regression','Wartung: ROOT erhält bp-show-entlassen nach Klick', ROOT.classList.contains('bp-show-entlassen'));
    }
    showEntlassen = false; renderTable(state);   // sauberen Zustand wiederherstellen

    // [Inline-Datum robust] Kalender-Öffnen (blur) bricht das Editing NICHT ab;
    // gültiges Datum via 'change' committet.
    state = JSON.parse(JSON.stringify(fix.state));
    var diId='di_robust';
    state.clients=[{id:diId, name:'DI', aufnahmedatum:ddi(-30), kostenzusage_traeger:'PKV',
      kostenzusage_detail:'', kostenzusage_bis:'', verlaengerung_bis:ddi(20), verlaengerung_status:'keine',
      entlassdatum:'', kein_ue_gruppe:false, goae:false, bt_verbal:'', bt_nonverbal:''}];
    renderTable(state);
    var vbCell = ROOT.querySelector('td[data-bp-field="verlaengerung_bis"][data-bp-id="'+diId+'"]');
    if(vbCell){
      vbCell.dispatchEvent(new MouseEvent('click',{bubbles:true,cancelable:true}));
      var di = ROOT.querySelector('input.bp-inline-input');
      if(di){
        di.dispatchEvent(new Event('blur',{bubbles:true}));
        t.log('Regression','Inline-Datum: blur (Kalender) schließt Editing NICHT', !!ROOT.querySelector('input.bp-inline-input'));
        di.value = ddi(40);
        di.dispatchEvent(new Event('change',{bubbles:true}));
        var diAfter = state.clients.find(function(x){return x.id===diId;});
        t.assertEq('Regression','Inline-Datum: gültiges Datum via change committet', diAfter.verlaengerung_bis, ddi(40));
      }
    }

    // [VA-Reset] Neues Verlängerungsdatum bei Status 'bewilligt' → zurück auf 'VA stellen'.
    state = JSON.parse(JSON.stringify(fix.state));
    var vrId='va_reset';
    state.clients=[{id:vrId, name:'VAReset', aufnahmedatum:ddi(-60), kostenzusage_traeger:'PKV',
      kostenzusage_detail:'', kostenzusage_bis:'', verlaengerung_bis:ddi(5), verlaengerung_status:'genehmigt',
      entlassdatum:'', kein_ue_gruppe:false, goae:false, bt_verbal:'', bt_nonverbal:''}];
    renderTable(state);
    var vrCell = ROOT.querySelector('td[data-bp-field="verlaengerung_bis"][data-bp-id="'+vrId+'"]');
    if(vrCell){
      vrCell.dispatchEvent(new MouseEvent('click',{bubbles:true,cancelable:true}));
      var vrInp = ROOT.querySelector('input.bp-inline-input');
      if(vrInp){
        vrInp.value = ddi(45);
        vrInp.dispatchEvent(new Event('change',{bubbles:true}));
        var vrAfter = state.clients.find(function(x){return x.id===vrId;});
        t.assertEq('Regression','VA-Reset: bewilligt + neues Datum → zu_beantragen', vrAfter.verlaengerung_status, 'zu_beantragen');
        t.assertEq('Regression','VA-Reset: Status-Badge wird „VA stellen"', computeStatus(vrAfter, fix.today).code, S.VZUB);
      }
    }
  },

  // ────────────────────── VELOCITY-RENDER-SMOKE ──────────────────────
  // Prüft: keine Velocity-Direktiven-Korruption in der finalen CSS
  runVelocitySmoke: function(){
    var t = this;
    // 1. Logo wurde nicht weg-ge-velocity'd
    var logo = ROOT.querySelector('.bp-titlebar-logo');
    t.log('Velocity','Logo gerendert (Macro-Body intakt)', !!logo);

    // 2. CSS enthält Footer-Hide Selektoren (${H} → # nach Velocity)
    var styleEls = ROOT.querySelectorAll('style');
    var allCss = '';
    for(var i=0;i<styleEls.length;i++) allCss += styleEls[i].textContent;
    t.log('Velocity','CSS enthält ${H}footer-Regel (Velocity-Escape funktioniert)',
          allCss.indexOf('${H}footer')!==-1);
    t.log('Velocity','CSS enthält ${H}poweredby-Regel',
          allCss.indexOf('${H}poweredby')!==-1);
    t.log('Velocity','CSS enthält ${H}comments-section-Regel (Kommentare im Druck aus)',
          allCss.indexOf('${H}comments-section')!==-1);

    // 3. Keine Footer-HTML-Korruption (Confluence-Macro ausversehen ausgelöst?)
    var corruption = allCss.indexOf('<ul id="poweredby">')!==-1 ||
                     allCss.indexOf('Atlassian Confluence')!==-1;
    t.log('Velocity','CSS frei von Footer-HTML-Injektion', !corruption,
          corruption?'Footer-HTML in CSS gefunden (Velocity-Bug!)':'');

    // 4. Titlebar-Override-Selektor ist im CSS
    t.log('Velocity','CSS enthält .bp-table thead tr.bp-titlebar-row th (Specificity-Fix)',
          allCss.indexOf('thead tr.bp-titlebar-row th')!==-1);
  },

  // ────────────────────────── SICHERHEIT ──────────────────────────
  runSafety: function(origStateJson){
    var t = this;
    // 1. Echte saveState-Aufrufe = 0 (alle in Sandbox abgefangen)
    t.log('Sicherheit','Echtes saveState: 0 Aufrufe ('+SELFTEST.recorders.saveCalls+' an Recorder)',
          true, SELFTEST.recorders.saveCalls + ' Recorder-Aufrufe — kein echter REST-Call');
    // 2. Modell unverändert (JSON-Vergleich vor/nach)
    var currentJson = JSON.stringify(state);
    t.log('Sicherheit','Echtes Modell unverändert', currentJson===origStateJson,
          currentJson===origStateJson ? '' : 'state hat sich geändert!');
  },

  // ───────────────────────── MAIN ENTRY ─────────────────────────
  run: function(){
    this.results = [];
    var fix;
    try{ fix = this.buildFixture(); }
    catch(e){ this.log('Fehler','Fixture-Aufbau: '+e.message, false); this.render(); return; }

    var origJson;
    try{
      this.startSandbox(fix);
      try{ this.runUnit(fix); }
      catch(e){ this.log('Fehler','Unit-Tests abgebrochen: '+e.message, false); }
      try{ this.runIntegration(fix); }
      catch(e){ this.log('Fehler','Integration-Tests abgebrochen: '+e.message, false); }
    }finally{
      origJson = this.endSandbox();
    }
    if(origJson) this.runSafety(origJson);
    this.runVelocitySmoke();

    this.render();
  },

  render: function(){
    var el = document.getElementById('bp-selftest-result-'+instId);
    if(!el) return;
    if(!this.results.length){ el.innerHTML='<p style="color:#5e6c84">Keine Ergebnisse.</p>'; return; }
    var groups = {};
    this.results.forEach(function(r){ (groups[r.g]=groups[r.g]||[]).push(r); });
    var order = ['Unit','Status','Integration','Regression','Sicherheit','Velocity','Fehler'];
    var html = '';
    var totalOk=0, totalFail=0;
    this.results.forEach(function(r){ r.ok?totalOk++:totalFail++; });
    html += '<div style="padding:8px 12px;margin-bottom:10px;border-radius:4px;font-weight:600;'+
            (totalFail===0?'background:#e3fcef;color:#006644':'background:#ffebe6;color:#bf2600')+'">'+
            (totalFail===0?'\u2713 ':'\u2717 ')+'Selbsttest: '+totalOk+'/'+(totalOk+totalFail)+
            (totalFail?' ('+totalFail+' rot)':' grün')+'</div>';
    order.forEach(function(g){
      var items = groups[g]; if(!items) return;
      var fail = items.filter(function(r){return !r.ok;}).length;
      html += '<h5 style="margin:12px 0 4px;font-size:13px;color:'+(fail===0?'#006644':'#bf2600')+'">'+
              g+' — '+(items.length-fail)+'/'+items.length+'</h5>';
      html += '<ul style="list-style:none;padding:0;margin:0;font-size:11.5px">';
      items.forEach(function(r){
        var bg = r.ok?'#f0fbf5':'#ffebe6';
        var fg = r.ok?'#006644':'#bf2600';
        html += '<li style="padding:3px 9px;border-radius:3px;background:'+bg+';color:'+fg+
                ';margin-bottom:1px">'+(r.ok?'\u2713':'\u2717')+' '+h(r.n);
        if(r.d) html += '<span style="opacity:.75"> — '+h(r.d)+'</span>';
        html += '</li>';
      });
      html += '</ul>';
    });
    el.innerHTML = html;
  }
};

