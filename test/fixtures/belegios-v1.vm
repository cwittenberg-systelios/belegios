function handleSaveSettings(){
  var v=parseInt(document.getElementById('bp-s-grenze').value,10);
  if(isNaN(v)||v<1||v>365){
    showErr({'bp-s-grenze':'Bitte eine Zahl zwischen 1 und 365 eingeben'});return;
  }
  state.config=state.config||{};
  var bakG=state.config.entscheidungsGrenze;
  var bakV=state.viewCols;
  var hadThV=('thVerbal'    in state.config), bakThV =state.config.thVerbal;
  var hadThNV=('thNonverbal' in state.config), bakThNV=state.config.thNonverbal;
  state.config.entscheidungsGrenze=v;
  // Bezugstherapeuten: ab jetzt Einstellung (hat Vorrang vor Macro-Parameter).
  var thvEl =document.getElementById('bp-s-thv');
  var thnvEl=document.getElementById('bp-s-thnv');
  if(thvEl)  state.config.thVerbal    = parseThList(thvEl.value);
  if(thnvEl) state.config.thNonverbal = parseThList(thnvEl.value);
  state.viewCols=readColToggles('bp-view-col-cb');
  closeModal();
  renderTable(state);renderBanner(state);
  applyViewCSS();
  saveState(state, {replay: replaySetTop({config: state.config, viewCols: state.viewCols})}).then(function(){setStatus('Einstellungen gespeichert.');}).catch(function(e){
    state.config.entscheidungsGrenze=bakG;state.viewCols=bakV;
    if(hadThV)  state.config.thVerbal=bakThV;     else delete state.config.thVerbal;
    if(hadThNV) state.config.thNonverbal=bakThNV; else delete state.config.thNonverbal;
    renderTable(state);renderBanner(state);applyViewCSS();
    setStatus('Fehler: '+e.message,true);
  });
}
// ── INLINE-EDIT ─────────────────────────────────────────────────────
function handleInlineEdit(td, clientId, field, type) {
  if (!canEdit) return;
  var client = state.clients.find(function(x){return x.id===clientId;});
  if (!client) return;

  var currentVal = client[field] || '';
  var input = document.createElement('input');
  input.className = 'bp-inline-input';

  if (type === 'date') {
    input.type = 'date';
    input.value = currentVal;
    input.min = dateMin(); input.max = dateMax();
    wireFlexDate(input);
    td.innerHTML = '';
    td.appendChild(input);
    input.focus();

    var dsaved = false;
    function cleanupDate(){ document.removeEventListener('mousedown', outsideDate, true); }
    function commitDate(force){
      if (dsaved) return;
      var newVal = input.value.trim() || null;
      // Beim Tippen des Jahres entstehen Zwischenstände wie '0002-..' (out of range).
      // Diese NICHT verwerfen — sonst bricht die Eingabe nach der ersten Ziffer ab.
      // Editing offen lassen, bis ein gültiges Datum getippt/gewählt wurde.
      if (newVal && !dateInRange(newVal)) {
        if (force) { dsaved = true; cleanupDate(); renderTable(state); setStatus(dateRangeMsg(), true); }
        return;
      }
      dsaved = true; cleanupDate();
      if (newVal === (currentVal || null)) { renderTable(state); return; }
      var backup = client[field];
      var statusBackup = client.verlaengerung_status;
      client[field] = newVal;
      client.updatedAt = new Date().toISOString();
      var _patch = {}; _patch[field] = newVal;
      // Neues Verlängerungsdatum ⇒ ein neuer VA ist fällig: ein bereits bewilligter
      // oder beantragter Status wird auf 'zu_beantragen' (VA stellen) zurückgesetzt.
      if (field === 'verlaengerung_bis' && newVal &&
          (client.verlaengerung_status === 'genehmigt' || client.verlaengerung_status === 'beantragt' ||
           client.verlaengerung_status === 'abgelehnt' || client.verlaengerung_status === 'widerspruch')) {
        client.verlaengerung_status = 'zu_beantragen';
        _patch.verlaengerung_status = 'zu_beantragen';
      }
      renderTable(state); renderBanner(state);
      saveState(state, {replay: replaySetClientFields(clientId, _patch, client)}).catch(function(e){
        client[field] = backup; client.verlaengerung_status = statusBackup; renderTable(state);
        setStatus('Fehler: '+e.message, true);
      });
    }
    function cancelDate(){ dsaved = true; cleanupDate(); renderTable(state); }
    function outsideDate(e){ if (!td.contains(e.target)) commitDate(true); }

    // 'change' feuert bei Kalenderauswahl UND bei vollständig getipptem Datum.
    input.addEventListener('change', function(){ commitDate(false); });
    input.addEventListener('keydown', function(e){
      if (e.key === 'Enter') { e.preventDefault(); commitDate(true); }
      else if (e.key === 'Escape') { e.preventDefault(); cancelDate(); }
    });
    // Klick außerhalb committet. Native Kalender-Klicks erzeugen KEIN Page-mousedown,
    // daher schließt das Öffnen/Bedienen des Kalenders das Editing NICHT mehr.
    // KEIN blur->save: das Öffnen des Kalenders blurrt in manchen Browsern den Input.
    setTimeout(function(){ if(!dsaved) document.addEventListener('mousedown', outsideDate, true); }, 0);
    return;
  } else if (type === 'text-kt') {
    // Kostentraeger-Zelle: zweite Zeile fuer Detail
    input.type = 'text';
    input.value = client.kostenzusage_traeger || '';
    var inputDetail = document.createElement('input');
    inputDetail.className = 'bp-inline-input';
    inputDetail.type = 'text';
    inputDetail.value = client.kostenzusage_detail || '';
    inputDetail.placeholder = 'Detail (z.B. PKV 6W)';
    inputDetail.style.marginTop = '2px';
    td.innerHTML = '';
    td.appendChild(input);
    td.appendChild(inputDetail);
    input.focus();
    function saveKt() {
      var t = input.value.trim(), d = inputDetail.value.trim();
      if (t === (client.kostenzusage_traeger||'') && d === (client.kostenzusage_detail||'')) {
        renderTable(state); return;
      }
      var backup = {kostenzusage_traeger: client.kostenzusage_traeger, kostenzusage_detail: client.kostenzusage_detail};
      client.kostenzusage_traeger = t || null;
      client.kostenzusage_detail = d || null;
      client.updatedAt = new Date().toISOString();
      renderTable(state); renderBanner(state);
      saveState(state, {replay: replaySetClientFields(client.id,
        {kostenzusage_traeger: client.kostenzusage_traeger, kostenzusage_detail: client.kostenzusage_detail},
        client)}).catch(function(e){
        Object.assign(client, backup); renderTable(state);
        setStatus('Fehler: '+e.message, true);
      });
    }
    var saving = false;
    [input, inputDetail].forEach(function(el){
      el.addEventListener('keydown', function(e){
        if (e.key==='Enter') el.blur();
        if (e.key==='Escape') { renderTable(state); }
      });
      el.addEventListener('blur', function(){
        if (saving) return; saving = true;
        setTimeout(function(){
          if (!td.contains(document.activeElement)) saveKt();
          else saving = false;
        }, 150);
      });
    });
    return;
  } else {
    input.type = 'text';
    input.value = currentVal;
  }

  td.innerHTML = '';
  td.appendChild(input);
  input.focus();
  if (input.type === 'text') input.select();

  var saved = false;
  function save() {
    if (saved) return; saved = true;   // Doppel-Save verhindern (change + blur)
    var newVal = input.value.trim() || null;
    if (newVal === (currentVal || null)) { renderTable(state); return; }
    if (type === 'date' && newVal && !dateInRange(newVal)) {
      renderTable(state); setStatus(dateRangeMsg(), true); return;   // ungültiges Jahr verwerfen
    }
    var backup = client[field];
    client[field] = newVal;
    client.updatedAt = new Date().toISOString();
    var _patch = {}; _patch[field] = newVal;
    renderTable(state); renderBanner(state);
    saveState(state, {replay: replaySetClientFields(clientId, _patch, client)}).catch(function(e){
      client[field] = backup; renderTable(state);
      setStatus('Fehler: '+e.message, true);
    });
  }
  input.addEventListener('blur', save);
  // Native <input type="date">: 'change' feuert zuverlässig bei Auswahl im
  // Kalender-Popup; 'blur' bleibt dort oft aus. Sonst würden Status/Ü-Gruppe
  // nach Datumsänderung nicht neu berechnet. blur dient als Backup.
  if (input.type === 'date') input.addEventListener('change', save);
  input.addEventListener('keydown', function(e){
    if (e.key==='Enter') input.blur();
    if (e.key==='Escape') { saved = true; renderTable(state); }  // Discard, Save blocken
  });
}

function handleInlineToggle(clientId, field) {
  if (!canEdit) return;
  mutate(clientId, function(client){ client[field] = !client[field]; });
}

