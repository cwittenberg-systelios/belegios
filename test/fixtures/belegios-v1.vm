// thSrcHint: erklaert, woher die aktuell angezeigte Liste stammt.
function thSrcHint(cfgKey, paramList){
  if(thSource(cfgKey)==='settings')
    return 'Quelle: <strong>Einstellungen</strong> (hat Vorrang vor dem Macro-Parameter).';
  if(paramList.length)
    return 'Quelle: <strong>Macro-Parameter</strong> (veraltet) &mdash; hier vorbelegt. '+
           'Nach dem Speichern gilt die Einstellung und hat Vorrang.';
  return 'Noch nicht gepflegt. Leer lassen &rarr; Freitext statt Auswahlliste.';
}

