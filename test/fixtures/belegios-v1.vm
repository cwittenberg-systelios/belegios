    '<span class="bp-titlebar-meta"> · '+ac+' aktive Klient(en)<span class="bp-screen-only">'+capTxt+'</span> · Stand: '+today.toLocaleDateString('de-DE')+(isPreview?' (Planungsstand)':'')+'<span class="bp-meta-vorlauf"> · '+getEntscheidungsGrenze()+' Tage Vorlauf</span><span class="bp-screen-only">'+geplantNote+entlassenToggle+'</span></span>'+
    tbBtns+
    '</th></tr>';

  TABLE_EL.innerHTML=
    '<div class="bp-table-wrap">'+
