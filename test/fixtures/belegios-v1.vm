.bp-input.bp-input-error{border-color:#de350b}
.bp-field-error{color:#de350b;font-size:11px;margin-top:3px}
.bp-req{color:#de350b}
.bp-hint{font-size:11px;color:#97a0af;margin-top:3px;line-height:1.4}
.bp-hint-workflow{font-size:11px;color:#5e6c84;background:#f4f5f7;padding:6px 8px;border-radius:3px;margin-bottom:8px;line-height:1.5}
.bp-checkbox-label{display:flex;align-items:flex-start;gap:6px;cursor:pointer;font-size:13px;font-weight:400;color:#172b4d}
.bp-checkbox-label input[type=checkbox]{margin-top:2px;flex-shrink:0}
