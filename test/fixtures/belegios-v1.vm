## Macro title: Belegungsplaner
## Macro has a body: N
## Body processing: Selected body processing option
## Output: Selected output option
##
## Developed by: Carsten Wittenberg
## Date created: dd/mm/yyyy
## @param Gruppenbezeichnung:title=Gruppenbezeichnung|type=string|required=true|desc=Name der Gruppe die zu planen ist.
## @param TherapeutenVerbal:title=TherapeutenVerbal|type=string|required=false|desc=VERALTET - jetzt in den Einstellungen (Zahnrad) pflegen. Dient nur noch als Fallback/Vorbelegung. Trennen mit Komma.
## @param TherapeutenNonVerbal:title=TherapeutenNonVerbal|type=string|required=false|desc=VERALTET - jetzt in den Einstellungen (Zahnrad) pflegen. Dient nur noch als Fallback/Vorbelegung. Trennen mit Komma.
## Velocity-Escape (Pitfall #1)
#set( $D = '$' )
#set( $H = '#' )

#if( !$paramGruppenbezeichnung || $paramGruppenbezeichnung == '' )
<div style="color:#c00;border:2px solid #c00;padding:8px 12px;border-radius:3px;font-family:sans-serif">
  <strong>Belegungsplaner:</strong> Parameter <em>Gruppenbezeichnung</em> fehlt.
  Bitte Macro bearbeiten und den Parameter setzen (z.&nbsp;B. &ldquo;gruppe5&rdquo;).
</div>
#else

<!-- BEGIN BELEGUNGSPLANER $paramGruppenbezeichnung -->
<div class="bp-root"
     id="bp-root-${paramGruppenbezeichnung}"
     data-page-id="$content.getId()"
     data-page-path="$content.getUrlPath()"
     data-inst-id="${paramGruppenbezeichnung}"
     data-th-verbal="$!paramTherapeutenVerbal"
     data-th-nonverbal="$!paramTherapeutenNonVerbal">

<style>
/* Pitfall #6: style im Macro-Body, nicht im head */
/* Pitfall #10: display:table-* !important gegen Confluence-CSS-Resets */
.bp-root{font-family:-apple-system,Segoe UI,sans-serif;font-size:14px;color:#172b4d;position:relative}
.bp-root table{display:table !important;width:100%;border-collapse:collapse}
.bp-root thead{display:table-header-group !important}
.bp-root tbody{display:table-row-group !important}
.bp-root tr{display:table-row !important;overflow:visible !important;position:static !important}
.bp-root td,.bp-root th{display:table-cell !important;padding:5px 8px;border-bottom:1px solid #dfe1e6;vertical-align:middle;white-space:nowrap}
.bp-root td.bp-detail{white-space:normal;min-width:120px}
/* Sticky (Pitfall #9: kein overflow:hidden auf Vorfahren) */
.bp-table-wrap{overflow-x:auto;overflow-y:auto;max-height:72vh;position:relative}
.bp-table{table-layout:auto;min-width:1100px}
.bp-table thead th{position:sticky;top:0;background:#f4f5f7;z-index:2;font-weight:600;font-size:12px;text-align:left;border-bottom:2px solid #c1c7d0;white-space:nowrap}
.bp-table thead th.bp-sticky-col{z-index:3}
.bp-table thead th.bp-sortable{cursor:pointer;user-select:none}
.bp-table thead th.bp-sortable:hover{background:#e9ebef}
.bp-table thead th.bp-sorted{color:#0052cc;background:#e9ebef}
.bp-table td.bp-sticky-col,.bp-table th.bp-sticky-col{position:sticky;left:0;background:inherit;z-index:1;box-shadow:2px 0 4px -2px rgba(0,0,0,.15)}
.bp-table tbody tr{background:#fff}
.bp-table tbody tr:nth-child(even){background:#fafbfc}
.bp-table tbody tr:hover{background:#f0f4ff}
/* Entlassene: komplett ausblenden */
.bp-table tbody tr.bp-row-entlassen{display:none !important}
/* Wartungs-Ansicht: entlassene Zeilen einblenden (dezent markiert) */
.bp-root.bp-show-entlassen .bp-table tbody tr.bp-row-entlassen{display:table-row !important}
.bp-root.bp-show-entlassen .bp-table tbody tr.bp-row-entlassen td{color:#97a0af;background:#fff7f5 !important}
.bp-root.bp-show-entlassen .bp-table tbody tr.bp-row-entlassen td.bp-sticky-col{font-style:italic}
.bp-entlassen-toggle{color:#fff;cursor:pointer;text-decoration:underline;font-weight:600}
.bp-entlassen-toggle:hover{color:#ffd9dd}
.bp-screen-only{display:inline}
/* Ü-Gruppe: nur Namensspalte grau */
.bp-table tr.bp-row-in_ue_gruppe td{color:#97a0af}
.bp-table tr.bp-row-in_ue_gruppe td.bp-sticky-col{color:#97a0af;font-style:italic}
/* Geplante (zukünftige) Aufnahmen: sichtbar, dezent blau; zählen nicht ins Kontingent */
.bp-table tr.bp-row-aufnahme_geplant td{color:#5e6c84;background:#f0f6ff}
.bp-table tr.bp-row-aufnahme_geplant td.bp-sticky-col{color:#5e6c84;font-style:italic;background:#f0f6ff}
.bp-center{text-align:center}
.bp-na{color:#aaa}
/* Badges */
.bp-badge{display:inline-block;padding:2px 7px;border-radius:10px;font-size:11px;font-weight:700;line-height:1.5;white-space:nowrap}
/* Toolbar */
.bp-toolbar{display:flex;gap:6px;padding:6px 0;flex-wrap:wrap;align-items:center}
/* Buttons */
.bp-btn{padding:5px 12px;border:1px solid #c1c7d0;background:#f4f5f7;cursor:pointer;border-radius:3px;font-size:13px;font-family:inherit;color:#172b4d;line-height:1.4}
.bp-btn:hover{background:#e4e5e9}
