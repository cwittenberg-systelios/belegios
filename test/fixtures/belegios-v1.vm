    background:rgb(151,19,33) !important;color:#fff !important;
    padding:10px 14px !important;vertical-align:middle !important;
    border:none !important;position:static !important;
    text-transform:none !important;letter-spacing:.01em !important;
    -webkit-print-color-adjust:exact;print-color-adjust:exact}
  .bp-titlebar-buttons{display:none !important}
  .bp-meta-vorlauf{display:none !important}
  .bp-titlebar-logo-wrap{float:right;margin-left:16px;line-height:0}
  .bp-titlebar-logo{height:38px;display:block;filter:brightness(0) invert(1)}
  .bp-titlebar-text{font-size:22px;font-weight:700;letter-spacing:.01em;line-height:1.15}
  .bp-titlebar-meta{font-size:11px;opacity:.85;margin-left:10px;font-weight:400}

  /* Spalten-Header — Gemischte Schreibung, sanfte Linie */
  .bp-table thead th{
    position:static;background:#fafbfc !important;color:#42526e !important;
    font-size:10.5px;font-weight:600;letter-spacing:0;
    padding:8px 6px;border:none;border-bottom:1.5px solid #c1c7d0;
    white-space:nowrap;text-align:left}
  .bp-table thead th.bp-sticky-col{left:auto;box-shadow:none}

  /* Datenzellen — luftiger, sanfte Trennlinien */
  .bp-table tbody tr{height:30px;page-break-inside:avoid}
  .bp-table tbody td{
    padding:7px 6px;border:none;border-bottom:1px solid #ebecf0;
    font-size:11px;vertical-align:middle;background:#fff !important}

  /* Zebra dezent */
  .bp-table tbody tr:nth-child(even) td{background:#fafbfc !important}

  /* Name-Spalte leicht betonen */
  .bp-table td.bp-sticky-col{font-weight:600;left:auto;box-shadow:none}

  /* Status-Badge kompakt */
  .bp-badge{
    font-size:8px;padding:1px 5px;border-radius:8px;
    -webkit-print-color-adjust:exact;print-color-adjust:exact}

  /* Rückmeldungs-Spalte */
  td.bp-col-rm{width:90px}

  /* Sticky aufheben */
  .bp-sticky-col{position:static !important;box-shadow:none !important}

  /* Entlassene ausblenden */
  .bp-table tbody tr.bp-row-entlassen{display:none !important}
  .bp-table tbody tr.bp-row-aufnahme_geplant{display:none !important}
  /* Inline-edit Markierung nur auf Spans entfernen (nicht auf TDs!) */
  span.bp-ec,span.bp-editable{cursor:default !important;border-bottom:none !important;background:none !important}
  td.bp-ec,td.bp-editable{cursor:default !important;background:none !important}
  /* Confluence-Seitenchrome verstecken — nur unsere Macro-Tabelle drucken */
  /* Confluence chrome ausblenden — ${H} = '#' nach Velocity (ID-Spezifität für Override!) */
  ${H}header,${H}navigation,${H}breadcrumbs,.ia-fixed-sidebar,
  h1.pagetitle,${H}title-heading,
  ${H}likes-and-labels-container,
  .page-metadata-modification-info,
  .wiki-content>*:not(.wysiwyg-macro),
  .wysiwyg-macro-body>*:not(.bp-root){
    display:none !important}
  /* Footer: ID-Selektoren via Velocity-Escape */
  ${H}footer,${H}footer *,
  ${H}footer-logo,${H}footer-logo *,
  ${H}poweredby,${H}poweredby *,
