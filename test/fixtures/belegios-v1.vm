function getDefaultSubject(){
  return 'Belegungsliste '+instId+' — Stand '+new Date().toLocaleDateString('de-DE');
}

// Textbaustein mit dem Permalink. LINK_LABEL dient zugleich als Marker,
// um eine bereits vorhandene Einbettung zu erkennen (keine Dubletten).
var LINK_LABEL='Immer aktueller Stand online:';
function getLinkBlock(){ return LINK_LABEL+'\n'+getPermaLink(); }

// bodyHasLink: erkennt den Baustein am Label ODER an der URL (auch ohne Anker,
// falls jemand den Link von Hand gekuerzt hat).
function bodyHasLink(body){
  if(!body) return false;
  if(body.indexOf(LINK_LABEL)>=0) return true;
  return linkVariants().some(function(u){ return body.indexOf(u)>=0; });
}

// ensureLinkInBody: haengt den Link-Baustein an einen gespeicherten Text an,
// der ihn noch nicht enthaelt (Vorlagen aus der Zeit vor diesem Feature).
// Wird eine Grussformel am Ende erkannt, wird davor eingefuegt statt dahinter.
var GRUSS_RE=/\n[ \t]*((?:Beste|Viele|Herzliche|Liebe|Freundliche)\s+Gr(?:ü|ue)(?:ß|ss)e|Mit\s+freundlichen\s+Gr(?:ü|ue)(?:ß|ss)en|LG|VG|MfG)\b[\s\S]*$/;
function ensureLinkInBody(body){
  if(bodyHasLink(body)) return body;
  var block=getLinkBlock();
  if(!body || !body.trim()) return block;
  var m=body.match(GRUSS_RE);
  if(m) return body.slice(0, m.index).replace(/\s+$/,'')+'\n\n'+block+'\n'+m[0];
  return body.replace(/\s+$/,'')+'\n\n'+block;
}

// swapLink: ersetzt eine bereits eingesetzte lange Form durch den Kurzlink,
// falls dieser erst nach dem Rendern des Dialogs verfuegbar wurde.
function swapLink(text, fromUrl, toUrl){
  if(!text || !fromUrl || !toUrl || fromUrl===toUrl) return text;
  return text.split(fromUrl).join(toUrl);
}

function getDefaultBody(){
  var ac=getActiveCount(state.clients);
  return 'Liebe Kollegin, lieber Kollege,\n\n'+
    'hier der Link zur Belegungsliste '+instId+'.\n\n'+
    'Stand: '+new Date().toLocaleDateString('de-DE')+'\n'+
    'Aktive Klienten: '+ac+'\n\n'+
    getLinkBlock()+'\n\n'+
    'Bei Rückfragen einfach melden.\n\nBeste Grüße';
}

function handleVersandMail(){
  var to=val('bp-v-to'), cc=val('bp-v-cc');
  var subject=val('bp-v-subject');
  var bodyEl=document.getElementById('bp-v-body');
  var body=bodyEl?bodyEl.value:'';
  if(!to){showErr({'bp-v-to':'Empfänger erforderlich'});return;}
  if(body.length>1500) setStatus('Hinweis: Nachricht ist lang — könnte in manchen Mail-Clients gekürzt werden.');
  state.mailTemplate={to:to,cc:cc,subject:subject,body:body};
  saveState(state, {replay: replaySetTop({mailTemplate: state.mailTemplate})}).catch(function(){});
  var params=[];
  if(cc)      params.push('cc='+encodeURIComponent(cc));
  if(subject) params.push('subject='+encodeURIComponent(subject));
  if(body)    params.push('body='+encodeURIComponent(body));
  var mailto='mailto:'+encodeURIComponent(to)+(params.length?'?'+params.join('&'):'')
  closeModal();
  setTimeout(function(){
    window.location.href=mailto;
    setTimeout(function(){
      setStatus('Falls kein Mail-Programm geöffnet hat: manuell senden an '+to);
    },3000);
  },150);
}

// Flexible Datumseingabe: DD.MM.YYYY / DD.MM.YY / DD.MM. → ISO
function parseFlexDate(str){
  if(!str)return null;
  str=str.trim();
  if(/^\d{4}-\d{2}-\d{2}$/.test(str))return str;
  var m=str.match(/^(\d{1,2})\.(\d{1,2})\.?(\d{2,4})?$/);
  if(m){
    var d=m[1].padStart(2,'0');
    var mo=m[2].padStart(2,'0');
    var y=m[3]||String(new Date().getFullYear());
    if(y.length===2)y='20'+y;
    return y+'-'+mo+'-'+d;
  }
  return null;
}
function wireFlexDate(input){
  input.addEventListener('paste',function(e){
    e.preventDefault();
    var txt=(e.clipboardData||window.clipboardData).getData('text');
    var iso=parseFlexDate(txt);
    if(iso)input.value=iso;
  });
  input.addEventListener('blur',function(){
    var iso=parseFlexDate(input.value);
    if(iso&&iso!==input.value)input.value=iso;
  });
}


