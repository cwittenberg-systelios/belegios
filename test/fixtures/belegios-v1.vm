/* ── @media print (Sprint 6) ── */
@media print {
  /* Ausblenden: Toolbar, Banner, Status, Modals, Edit-Buttons, Anleitung */
  .bp-toolbar,.bp-banner,.bp-update-banner,.bp-status,.bp-readonly-hint,
  .bp-capacity,.bp-screen-only,.bp-overlay,.bp-modal,.bp-row-action,
  .bp-guide,.bp-guide-body,.bp-print-header,.bp-tip{display:none !important}
  /* Edit-Buttons (bp-row-action) verbergen, NICHT die Datenzellen bp-ec/bp-editable */
