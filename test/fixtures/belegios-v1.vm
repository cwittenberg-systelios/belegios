// mutate(): zentraler Optimistic-Update-Zyklus mit Rollback.
// applyFn(client) mutiert den Klienten in-place (oder gibt Patch-Objekt zurück).
// opts: {close:true schließt Modal, onError:fn} — render+save+rollback einheitlich.
function mutate(clientId, applyFn, opts){
  opts=opts||{};
  var idx=state.clients.findIndex(function(c){return c.id===clientId;});
  if(idx<0)return false;
  var client=state.clients[idx];
  var backup=JSON.parse(JSON.stringify(client));
  var ret=applyFn(client);
  if(ret&&typeof ret==='object')Object.assign(client,ret);
  client.updatedAt=new Date().toISOString();
  // Delta erfassen: welche Felder hat der Nutzer auf welche Zielwerte gesetzt?
  // (Idempotent für den Replay — auch bei relativen Operationen wie Toggles.)
  var changed={};
  Object.keys(client).forEach(function(k){
    if(JSON.stringify(client[k])!==JSON.stringify(backup[k])) changed[k]=client[k];
  });
  if(opts.close)closeModal();
  renderTable(state); renderBanner(state);
  saveState(state, {replay:replaySetClientFields(clientId, changed, client)}).catch(function(e){
    state.clients[idx]=backup; renderTable(state); renderBanner(state);
    if(opts.onError)opts.onError(e);
    else setStatus('Fehler: '+e.message,true);
  });
  return true;
}

// applyPatch: dünner Wrapper über mutate() — schließt Modal (Rückwärtskompat.)
function applyPatch(clientId, patch){
  mutate(clientId, function(){ return patch; }, {close:true});
}


