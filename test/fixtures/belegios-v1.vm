<script>
//<![CDATA[
/* Pitfall #2: CDATA-Wrap */
(function () {
'use strict';

// ╔══════════════════════════════════════════════════════════════════╗
// ║ VELOCITY-${H}-DISZIPLIN  (Pitfall ${H}1 — der häufigste Bug hier) ║
// ║ Confluence rendert dieses Template durch Velocity, BEVOR der JS-  ║
// ║ Code im Browser läuft. Velocity interpretiert '${H}wort' als      ║
// ║ Makro-Aufruf und '$Dwort' als Variable — AUCH in JS-Strings/CSS.  ║
// ║                                                                    ║
// ║ REGELN:                                                            ║
// ║  • Literales '${H}' in JS-Strings/CSS  →  '$D{H}'  (H ist als     ║
// ║    '${H}' definiert; Velocity setzt es ein, Resultat ist '${H}'). ║
// ║    Beispiel: indexOf('$D{H}footer') rendert zu indexOf('${H}foot')║
// ║  • Literales '$D' in JS-Strings        →  '$DD'  (D ist als '$D').║
// ║  • CSS-ID-Selektoren (${H}footer, ${H}poweredby) lösen Confluences║
// ║    eigene Velocity-Makros aus → IMMER '$D{H}' davor.              ║
// ║  • Der Velocity-Smoke-Test im SELFTEST prüft, dass das gerenderte  ║
// ║    CSS noch '${H}footer' enthält und keine Footer-HTML injiziert. ║
// ║  • Selbst DIESER Kommentar musste escaped werden — sonst hätte     ║
// ║    Velocity hier die Atlassian-Footer-HTML hineingerendert.       ║
// ╚══════════════════════════════════════════════════════════════════╝

// ── CONFIG ────────────────────────────────────────────────────────────
// Daten aus HTML-data-Attributen lesen — robuster als Inline-Script-Injektion
var allRoots = document.querySelectorAll('.bp-root[data-inst-id]');
var ROOT0    = allRoots[allRoots.length - 1]; // letztes = dieses Macro
// Fallback falls data-Attribut fehlt: AJS.params.pageId
var pageId   = (ROOT0 && ROOT0.getAttribute('data-page-id')) ||
               (window.AJS && AJS.params && AJS.params.pageId) || '';
var instId   = (ROOT0 && ROOT0.getAttribute('data-inst-id')) || '';
// ── Bezugstherapeuten-Listen ──────────────────────────────────────────
// Quelle 1 (NEU, Vorrang): state.config.thVerbal / state.config.thNonverbal
//   -> gepflegt im Einstellungsdialog (Zahnrad), pro Seite+Instanz gespeichert.
// Quelle 2 (ALT, Fallback): Macro-Parameter TherapeutenVerbal/-NonVerbal.
//   -> bleibt unveraendert funktionsfaehig und belegt den Dialog vor.
// Sobald die Einstellung einmal gespeichert wurde (auch als leere Liste),
// gewinnt sie gegenueber dem Macro-Parameter. Leere Liste = Freitext-Eingabe.
var _thV     = (ROOT0 && ROOT0.getAttribute('data-th-verbal'))    || '';
var _thNV    = (ROOT0 && ROOT0.getAttribute('data-th-nonverbal')) || '';
// parseThList: akzeptiert Array ODER String (Komma / Semikolon / Zeilenumbruch),
// trimmt, entfernt Leereintraege und Duplikate (case-insensitiv, erste Schreibweise gewinnt).
function parseThList(v){
  var arr = Array.isArray(v) ? v : String(v==null?'':v).split(/[,;\r\n]/);
  var seen={}, out=[];
  arr.forEach(function(x){
    var n=String(x==null?'':x).trim();
    if(!n) return;
    var k=n.toLowerCase();
    if(seen[k]) return;
    seen[k]=1; out.push(n);
  });
  return out;
}
var paramThVerbalList = parseThList(_thV);
var paramThNvList     = parseThList(_thNV);
function thListFor(cfgKey, paramList){
  var v = (state && state.config) ? state.config[cfgKey] : undefined;
  if (Array.isArray(v) || typeof v === 'string') return parseThList(v);
  return paramList.slice();
}
function getThVerbalList(){ return thListFor('thVerbal',    paramThVerbalList); }
function getThNvList()    { return thListFor('thNonverbal', paramThNvList); }
// Herkunft (fuer die Hinweistexte im Einstellungsdialog)
function thSource(cfgKey){
  var v = (state && state.config) ? state.config[cfgKey] : undefined;
  return (Array.isArray(v) || typeof v === 'string') ? 'settings' : 'param';
}
// ── Permalink auf diese Belegungsliste ────────────────────────────────
// pageId-basierte URL = echter Permalink: bleibt gueltig, wenn die Seite
// umbenannt oder in einen anderen Space verschoben wird.
// Fallback-Kette: pageId -> von Velocity gerenderter Seitenpfad -> aktuelle URL.
var _pagePath = (ROOT0 && ROOT0.getAttribute('data-page-path')) || '';
if (_pagePath.charAt(0) === '$') _pagePath = '';   // Velocity nicht aufgeloest
function getConfluenceBaseUrl(){
  var m = document.getElementById('confluence-base-url');
  var b = (m && (m.getAttribute('content') || m.content)) ||
          (window.AJS && AJS.Meta && AJS.Meta.get && AJS.Meta.get('base-url')) ||
          (window.AJS && AJS.params && AJS.params.baseUrl) || '';
  b = String(b || '').replace(/\/+$/, '');
  if (b) return b;
  var cp = (window.AJS && AJS.contextPath) ? AJS.contextPath() : '';
  return window.location.origin + String(cp || '').replace(/\/+$/, '');
}
// Kurzlink (Confluence "Teilen"-Link, z.B. /x/44RIAg). Kommt aus der REST-API
// (_links.tinyui) und ist dieselbe URL, die Confluence im Teilen-Dialog anbietet.
// Wird beim Init einmal geholt; bis dahin gilt die pageId-URL als Fallback —
// beide zeigen dauerhaft auf dieselbe Seite.
var tinyLink = '';
function fetchTinyLink(){
  if (!pageId) return Promise.resolve('');
  return fetch(_actCtx() + '/rest/api/content/' + encodeURIComponent(pageId),
               {headers:{Accept:'application/json'}})
    .then(function(r){ if(!r.ok) throw new Error('tinyui '+r.status); return r.json(); })
    .then(function(j){
      var l = (j && j._links) || {};
      if (!l.tinyui) return '';
      var base = String(l.base || getConfluenceBaseUrl()).replace(/\/+$/, '');
      tinyLink = base + l.tinyui;
      console.log('[bp]', instId, 'tinyLink =', tinyLink);
      return tinyLink;
    })
    .catch(function(e){ console.warn('[bp]', instId, 'tinyLink nicht verfuegbar', e); return ''; });
}

// Lange, stets funktionierende Form (Fallback und Erkennungsmuster).
function getLongLink(){
  var base = getConfluenceBaseUrl();
  if (pageId)         return base + '/pages/viewpage.action?pageId=' + encodeURIComponent(pageId);
  if (_pagePath)      return base + _pagePath;
  return String(window.location.href).split('#')[0];
}
function getPermaLink(){ return tinyLink || getLongLink(); }
// Frueher wurde ein Instanz-Anker angehaengt. Er wird nicht mehr erzeugt,
// aber in gespeicherten Vorlagen noch erkannt und entfernt (siehe dropLinkAnchor).
function linkAnchor(){ return '#bp-root-' + encodeURIComponent(instId); }
// Alle bekannten Schreibweisen desselben Ziels — fuer die Dubletten-Erkennung
// in gespeicherten Vorlagen (Kurzlink UND lange Form).
function linkVariants(){
  var out=[];
  [tinyLink, getLongLink()].forEach(function(u){ if(u) out.push(u); });
  return out;
}
// dropLinkAnchor: entfernt den frueher angehaengten Anker aus einem Text,
// aber nur direkt hinter einer bekannten Link-Form.
function dropLinkAnchor(text){
  if(!text) return text;
  var a=linkAnchor();
  if(text.indexOf(a)<0) return text;
  linkVariants().forEach(function(u){ text=text.split(u+a).join(u); });
  return text;
}

var PROP_KEY = 'belegungsplaner_' + pageId + '_' + instId;
var MAX_CAP       = 10;
var WARN_CAP      = 9;

var ROOT      = document.getElementById('bp-root-'    + instId) || ROOT0;
var STATUS_EL = document.getElementById('bp-status-'  + instId);
var BANNER_EL = document.getElementById('bp-banner-'  + instId);
var TABLE_EL  = document.getElementById('bp-table-'   + instId);
var MODAL_EL  = document.getElementById('bp-modal-'   + instId);

if (!ROOT) { console.error('[bp] Root nicht gefunden', instId); return; }

var state        = null;
var stateVersion = 0;
var canEdit      = false;
var showEntlassen = false;   // Wartungs-Umschalter: entlassene Klient:innen einblenden
var sortKey = 'aufnahme';    // Sortier-Spalte (COLS.key) — Klick auf Header ändert sie
var sortDir = 'asc';         // 'asc' | 'desc'; Standard: Aufnahmedatum aufsteigend

// ── SPRINT 1: AUTH + STORAGE ──────────────────────────────────────────
function checkCanEdit() {
  console.log('[bp]', instId, 'checkCanEdit start');
  // Confluence Server 7.4: currentuser.edit nicht zuverlässig via REST.
  // Edit-Button im DOM prüfen — Confluence rendert ihn nur für Nutzer mit Bearbeitungsrecht.
  canEdit = !!(
    document.querySelector('#editPageLink')                              ||
    document.querySelector('.editPageLink')                              ||
    document.querySelector('.toolbar-item .page-edit-button')            ||
    document.querySelector('[data-key*="editPageLink"]')                 ||
    document.querySelector('.aui-nav .edit-button-wrap a')               ||
    document.querySelector('#action-edit-page')
  );
  console.log('[bp]', instId, 'canEdit =', canEdit);
  return Promise.resolve();
}
function loadState() {
  var dupes = document.querySelectorAll('[id="bp-root-' + instId + '"]');
  if (dupes.length > 1) setStatus('WARNUNG: Gruppenbezeichnung "' + instId + '" ist auf dieser Seite doppelt vergeben!', true);
  console.log('[bp]', instId, 'loadState fetch', '/rest/api/content/' + pageId + '/property/' + PROP_KEY);
  return fetch('/rest/api/content/' + pageId + '/property/' + PROP_KEY,
    {headers:{Accept:'application/json'}})
  .then(function(r){
    console.log('[bp]', instId, 'property response status', r.status);
    if (r.status === 404) { state = emptyState(); stateVersion = 0; return state; }
    if (!r.ok) throw new Error('Laden fehlgeschlagen: ' + r.status);
    return r.json();
  }).then(function(j){
    if (j && j.value) { state = j.value; stateVersion = j.version.number; }
    console.log('[bp]', instId, 'state loaded, clients:', (state.clients||[]).length, 'version:', stateVersion);
    return state;
  });
}

// saveState(ns, opts) — optimistisches Speichern mit granularem Konflikt-Replay.
//   opts.replay(base): wendet NUR die eigene Änderung auf einen frisch geladenen
//     (fremden) Stand neu an und gibt den zusammengeführten Stand zurück.
//     Bei 409 (jemand anderes hat zwischenzeitlich gespeichert) wird so nicht der
//     komplette Snapshot überschrieben, sondern nur das eigene Delta gemergt —
//     fremde Änderungen an anderen Klienten/Feldern bleiben erhalten.
//   Ohne replay: Fallback = letzter-gewinnt (alter Stand wird überschrieben).
function saveState(ns, opts) {
  opts = opts || {};
  var retry  = opts.retry  || 0;
  var replay = opts.replay;
  if (!canEdit) return Promise.reject(new Error('Keine Schreibrechte.'));
  ns.lastModified = new Date().toISOString();
  var isNew = stateVersion === 0;
  var body  = {key:PROP_KEY, value:ns, version:{number:stateVersion+1}};
  return fetch('/rest/api/content/' + pageId + '/property/' + (isNew ? '' : PROP_KEY), {
    method: isNew ? 'POST' : 'PUT',
    headers:{'Content-Type':'application/json','X-Atlassian-Token':'no-check'},
    body: JSON.stringify(body)
  }).then(function(r){
    if (r.status === 409 && retry < 2) {
      // Konflikt: fremden Stand holen OHNE globalen state zu überschreiben
      // (damit ein etwaiger Rollback im Aufrufer korrekt bleibt), nur das eigene
      // Delta neu anwenden, dann den Merge speichern.
      return fetchFresh().then(function(fresh){
        stateVersion = fresh.version;
        var merged = replay ? replay(fresh.value) : ns;
        return saveState(merged, {retry:retry+1, replay:replay, merged:true});
      });
    }
    if (!r.ok) throw new Error('Speichern fehlgeschlagen: ' + r.status);
    return r.json().then(function(j){
      stateVersion = j.version.number;
      state = ns;
      // Nach erfolgreichem Merge: UI auf den zusammengeführten Stand bringen
      // (zeigt jetzt auch die fremden Änderungen, nicht nur das eigene Delta).
      if (opts.merged) { renderTable(state); renderBanner(state); }
      hideUpdateBanner();
      scheduleActivityBump();   // fachliche Änderung → (gedrosselt) Stream-Eintrag
      return state;
    });
  });
}

// fetchFresh(): liest den aktuellen Property-Stand (Wert + Versionsnummer),
// ohne den globalen state/stateVersion als Seiteneffekt zu verändern.
function fetchFresh(){
  return fetch('/rest/api/content/' + pageId + '/property/' + PROP_KEY,
    {headers:{Accept:'application/json'}})
  .then(function(r){
    if (r.status === 404) return {value: emptyState(), version: 0};
    if (!r.ok) throw new Error('Konflikt-Reload fehlgeschlagen: ' + r.status);
    return r.json().then(function(j){ return {value:j.value, version:j.version.number}; });
  });
}

// ── Replay-Helfer: beschreiben die eigene Änderung als Funktion, die sie auf
//    einen beliebigen (fremden) Basis-Stand neu anwendet. Idempotent: es werden
//    konkrete Zielwerte gesetzt, nicht relative Operationen wiederholt. ──
function replaySetClientFields(clientId, fields, fullClient){
  return function(base){
    base.clients = base.clients || [];
    var i = base.clients.findIndex(function(c){return c.id===clientId;});
    if (i < 0) { if (fullClient) base.clients.push(JSON.parse(JSON.stringify(fullClient))); }
    else { Object.assign(base.clients[i], fields); base.clients[i].updatedAt = new Date().toISOString(); }
    return base;
  };
}
function replayAddClient(client){
  return function(base){
    base.clients = base.clients || [];
    if (!base.clients.some(function(c){return c.id===client.id;}))
      base.clients.push(JSON.parse(JSON.stringify(client)));
    return base;
  };
}
function replayRemoveClient(clientId){
  return function(base){
    base.clients = (base.clients||[]).filter(function(c){return c.id!==clientId;});
    return base;
  };
}
function replaySetTop(fieldsObj){
  return function(base){ Object.assign(base, fieldsObj); return base; };
}

function emptyState(){
  return {schemaVersion:1, gruppenbezeichnung:instId, lastModified:new Date().toISOString(), clients:[]};
}

// ── SPRINT 2: COMPUTE + RENDER ────────────────────────────────────────
function parseISO(s){ if(!s)return null; var d=new Date(s+'T00:00:00'); return isNaN(d)?null:d; }
function toISO(d){
  if(!d)return null;
  return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());
}
function pad(n){ return String(n).padStart(2,'0'); }
function addDays(d,n){ if(!d)return null; var r=new Date(d); r.setDate(r.getDate()+n); return r; }
function daysBetween(a,b){ if(!a||!b)return null; return Math.round((b-a)/86400000); }
function sod(d){ var r=new Date(d); r.setHours(0,0,0,0); return r; }
// Datums-Plausibilität: nur aktuelles Jahr ±1 zulassen (verhindert Tippfehler
// wie '0002-07-10', die einen Klienten still in die Vergangenheit/„entlassen" schieben).
function dateMin(){ return (new Date().getFullYear()-1)+'-01-01'; }
function dateMax(){ return (new Date().getFullYear()+1)+'-12-31'; }
function dateInRange(iso){
  var d=parseISO(iso); if(!d) return false;
  var y=d.getFullYear(), now=new Date().getFullYear();
  return y>=now-1 && y<=now+1;
}
function dateRangeMsg(){ var y=new Date().getFullYear(); return 'Jahr muss zwischen '+(y-1)+' und '+(y+1)+' liegen'; }
function dateAttrs(type){ return type==='date' ? ' min="'+dateMin()+'" max="'+dateMax()+'"' : ''; }

// DateUtil: gebündelter Namespace aller Datums-Helfer (ein Ort zum Nachschlagen).
// Verweist auf die obigen/folgenden Funktionen (alle hoisted). Bestehende direkte
// Aufrufe (parseISO(...), toISO(...)) funktionieren unverändert weiter.
var DateUtil = {
  parseISO:parseISO, toISO:toISO, pad:pad, addDays:addDays,
  daysBetween:daysBetween, sod:sod, fmtDate:fmtDate, parseFlexDate:parseFlexDate
};

function vorlEntlass(c){ return parseISO(c.verlaengerung_bis) || parseISO(c.kostenzusage_bis) || null; }
function ueGruppe(c){
  if(c.kein_ue_gruppe)return null;
  var base=parseISO(c.entlassdatum)||vorlEntlass(c);
  // -6 Kalendertage = volle Woche zurück → jeder Wochentag (Mo–Fr) wird einmal
  // in der Ü-Gruppe besucht. Basis: Entlass (final) wenn gefüllt, sonst vorl. Entlass.
  return base?addDays(base,-6):null;
}
function behWochen(c, today){
  // Aktuelle (laufende) Behandlungswoche: Aufnahmetag = Woche 1,
  // Aufnahme + 7 Tage = Woche 2, usw. Nicht die geplante Gesamtdauer.
  var a=parseISO(c.aufnahmedatum);
  if(!a)return null;
  today = today || sod(new Date());
  if(a>today) return null;   // Aufnahme noch nicht erfolgt (geplant)
  return Math.max(1, Math.floor(daysBetween(a,today)/7)+1);
}

var S = {
  ENTLASSEN:'entlassen', UE:'in_ue_gruppe', ENT:'entscheidung_faellig',
  VGEH:'verl_genehmigt', VBEA:'verl_beantragt', VZUB:'verl_zu_beantragen',
  NEU:'aufnahme_neu', STABIL:'stabil', GEPLANT:'aufnahme_geplant',
  VABG:'verl_abgelehnt', VWID:'verl_widerspruch', VEK:'verl_eigene_kosten'
};

function getEntscheidungsGrenze(){
  return (state&&state.config&&state.config.entscheidungsGrenze)||17;
}

// Selbstzahler (SZ): keine Krankenkasse im Spiel → die Verlängerungsantrag-Status
// (VA stellen / VA beantragt / VA bewilligt) entfallen. 'Entscheidung' bleibt (neutral).
function isSelbstzahler(c){
  var k=(c.kostenzusage_traeger||'').trim().toUpperCase();
  return k==='SZ' || k.indexOf('SELBSTZAHLER')>=0;
}
function computeStatus(c, today){
  today = today || sod(new Date());
  var eD=parseISO(c.entlassdatum), ueD=ueGruppe(c), vE=vorlEntlass(c);
  var vs=c.verlaengerung_status||'keine';
  if(eD && eD<today) return {code:S.ENTLASSEN};
  // Zukünftige Aufnahme: Aufnahmedatum liegt nach dem Stichtag → noch nicht in der Gruppe.
  var aGepl=parseISO(c.aufnahmedatum);
  if(aGepl && aGepl>today) return {code:S.GEPLANT};
  // Ü-Gruppe im 6-Tage-Fenster VOR der (vorl.) Entlassung BIS EINSCHLIESSLICH Entlasstag:
  // ueD<=heute<=Entlasstag. Bei gesetztem Entlassdatum: eD>=today (Entlasstag selbst zählt
  // noch als Ü-Gruppe, erst der Folgetag ist entlassen, eD<today oben). Ohne Entlassdatum:
  // vorl. Entlass darf noch nicht überschritten sein (vE>=today) — sonst Entscheidung überfällig.
  if(ueD && ueD<=today && (eD ? eD>=today : vE>=today)) return {code:S.UE};
  if(!eD && vE){
    // ENT (Entscheidung) nur, solange der VA-Workflow noch NICHT in Bearbeitung/erledigt ist.
    var vaHandled=(vs==='beantragt'||vs==='genehmigt'||vs==='abgelehnt'||vs==='widerspruch'||vs==='eigene_kosten');
    var tb=daysBetween(today,vE);
    if(!vaHandled && tb<getEntscheidungsGrenze())
      return {code:S.ENT, tageBis:tb, ueberfaellig:tb<0};
  }
  // VA-Status nur bei Kostenträger mit Krankenkasse — für Selbstzahler (SZ) entfallen sie.
  if(!isSelbstzahler(c)){
    if(vs==='genehmigt') return {code:S.VGEH};
    if(vs==='eigene_kosten') return {code:S.VEK};
    if(vs==='widerspruch') return {code:S.VWID};
    if(vs==='abgelehnt') return {code:S.VABG};
    if(vs==='beantragt') return {code:S.VBEA};
    // VA stellen: verlaengerung_bis eingetragen, noch nicht weiter bearbeitet
    if(c.verlaengerung_bis && (vs==='keine'||vs==='zu_beantragen')) return {code:S.VZUB};
  }
  var a=parseISO(c.aufnahmedatum);
  if(a && daysBetween(a,today)<14) return {code:S.NEU};
  return {code:S.STABIL};
}

// STATUS_META: EINZIGE Quelle für Label und Badge-Farben je Status-Code.
// computeStatus liefert den code; badge() liest die Labels/Farben hier.
// Die CSS-Klasse bp-row-{code} nutzt denselben code-String.
// Hinweis: Die Zeilen-SORTIERUNG erfolgt NICHT mehr nach Status (das ließ Zeilen
// beim Editieren verrutschen), sondern fest nach Aufnahmedatum — siehe sortClients().
// Das Feld 'prio' wird daher für die Sortierung nicht mehr verwendet.
var STATUS_META={
  entscheidung_faellig:{label:'Entscheidung', bg:'#ff8c00',fg:'#fff',prio:0},
  verl_zu_beantragen:  {label:'VA stellen',   bg:'#ffab00',fg:'#000',prio:1},
  verl_beantragt:      {label:'VA beantragt', bg:'#0052cc',fg:'#fff',prio:2},
  aufnahme_neu:        {label:'Neu',          bg:'#abf5d1',fg:'#005c2e',prio:3},
  aufnahme_geplant:    {label:'Geplant',      bg:'#deebff',fg:'#0747a6',prio:7},
  stabil:              {label:null,           bg:null,    fg:null, prio:4},
  verl_genehmigt:      {label:'VA bewilligt', bg:'#36b37e',fg:'#fff',prio:5},
  verl_abgelehnt:      {label:'VA abgelehnt', bg:'#de350b',fg:'#fff',prio:1},
  verl_widerspruch:    {label:'Widerspruch',  bg:'#6554c0',fg:'#fff',prio:2},
  verl_eigene_kosten:  {label:'Eigene Kosten',bg:'#00857a',fg:'#fff',prio:5},
  in_ue_gruppe:        {label:'In \u00dc-Gruppe',bg:'#e8e8e8',fg:'#555',prio:6},
  entlassen:           {label:'Entlassen',    bg:'#e0e0e0',fg:'#666',prio:99}
};

function badge(st){
  var cfg=STATUS_META[st.code]; if(!cfg||!cfg.label)return '';
  var txt=cfg.label, bg=cfg.bg;
  if(st.code===S.ENT && st.tageBis!=null){
    txt += st.ueberfaellig?' ('+Math.abs(st.tageBis)+' T. \u00fcberf\u00e4llig!)'
                          :' ('+st.tageBis+' T.)';
    if(st.ueberfaellig) bg='#d04437';
  }
  return '<span class="bp-badge" style="background:'+bg+';color:'+cfg.fg+'">'+h(txt)+'</span>';
}

var WT=['So','Mo','Di','Mi','Do','Fr','Sa'];
function fmtDate(iso){
  if(!iso)return '<span class="bp-na">\u2014</span>';
  var d=typeof iso==='string'?parseISO(iso):iso;
  if(!d)return iso;
  return WT[d.getDay()]+' '+pad(d.getDate())+'.'+pad(d.getMonth()+1)+'.'+String(d.getFullYear()).slice(-2);
}

function h(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function statusPrio(code){
  var m=STATUS_META[code];
  return (m&&m.prio!=null)?m.prio:50;
}

// Header-Sortierung: Standard ist Aufnahmedatum aufsteigend (stabil — kein Verrutschen
// beim Editieren, solange nicht nach dem editierten Feld sortiert wird). Klick auf eine
// Header-Zelle wählt die Spalte; erneuter Klick dreht die Richtung. Entlassene bleiben
// IMMER am Ende; Tiebreak über Aufnahmedatum + id macht Gleichstände deterministisch.
function colByKey(k){ for(var i=0;i<COLS.length;i++){ if(COLS[i].key===k) return COLS[i]; } return null; }
function colSortVal(key, c, today){
  switch(key){
    case 'status':       return STATUS_META[computeStatus(c,today).code].prio;
    case 'name':         return (c.name||'').toLowerCase();
    case 'aufnahme':     return c.aufnahmedatum||'';
    case 'kz_traeger':   return (c.kostenzusage_traeger||'').toLowerCase();
    case 'kz_bis':       return c.kostenzusage_bis||'';
    case 'beh_wochen':   { var w=behWochen(c,today); return (w==null?-1:w); }
    case 'verl_bis':     return c.verlaengerung_bis||'';
    case 'goae':         return c.goae?1:0;
    case 'bt_verbal':    return (c.bt_verbal||'').toLowerCase();
    case 'bt_nonverbal': return (c.bt_nonverbal||'').toLowerCase();
    case 'kein_ue':      return c.kein_ue_gruppe?1:0;
    case 'vorl_entlass': { var v=vorlEntlass(c); return v?toISO(v):''; }
    case 'ue_gruppe':    { var u=ueGruppe(c);    return u?toISO(u):''; }
    case 'entlass':      return c.entlassdatum||'';
    case 'jupsy':        return c.jupsy?1:0;
    default:             return c.aufnahmedatum||'';
  }
}
function sortClients(cs,today){
  today = today || sod(new Date());
  var dir = (sortDir==='desc') ? -1 : 1;
  var key = colByKey(sortKey) ? sortKey : 'aufnahme';
  return cs.slice().sort(function(a,b){
    var ea=computeStatus(a,today).code===S.ENTLASSEN ? 1 : 0;
    var eb=computeStatus(b,today).code===S.ENTLASSEN ? 1 : 0;
    if(ea!==eb) return ea-eb;                          // entlassen immer ans Ende
    var va=colSortVal(key,a,today), vb=colSortVal(key,b,today);
    var cmp = (typeof va==='number' && typeof vb==='number') ? (va-vb) : String(va).localeCompare(String(vb));
    if(cmp!==0) return cmp*dir;
    var da=(a.aufnahmedatum||''), db=(b.aufnahmedatum||'');   // stabiler Tiebreak
    if(da!==db) return da.localeCompare(db);
    return String(a.id||'').localeCompare(String(b.id||''));
  });
}

function getActiveCount(cs, today){
  // Ü-Gruppe-Teilnehmer UND zukünftige (geplante) Aufnahmen zählen NICHT gegen die
  // Regelkapazität (9 reguläre + n Ü-Gruppe). today optional = Stichtag.
  today = today || sod(new Date());
  return cs.filter(function(c){
    var st=computeStatus(c,today);
    return st.code!==S.ENTLASSEN && st.code!==S.UE && st.code!==S.GEPLANT;
  }).length;
}

function renderTable(st, asOf){
  if(!st||!st.clients){TABLE_EL.innerHTML='<p style="color:#97a0af">Keine Daten.</p>';return;}
  var realToday=sod(new Date());
  var today = asOf ? sod(new Date(asOf+'T00:00:00')) : realToday;   // Stichtag (Druck-Vorschau) oder heute
  var isPreview = !!asOf && today.getTime()!==realToday.getTime();
  var sorted=sortClients(st.clients,today);
  var ac=getActiveCount(st.clients, today);
  var capTxt=ac>=MAX_CAP?' \u2014 <strong>Gruppe voll</strong>':ac>=WARN_CAP?' \u2014 Regelkapazit\u00e4t erreicht':'';
  // Wartungs-Umschalter: Anzahl entlassener (ausgeblendeter) Klient:innen
  var entlassenCount=st.clients.filter(function(c){return computeStatus(c,today).code===S.ENTLASSEN;}).length;
  // Zukünftige (geplante) Aufnahmen — sichtbar, aber nicht im Kontingent
  var geplantCount=st.clients.filter(function(c){return computeStatus(c,today).code===S.GEPLANT;}).length;
  var geplantNote = geplantCount>0 ? ' \u00b7 '+geplantCount+' geplant' : '';
  if(ROOT) ROOT.classList.toggle('bp-show-entlassen', showEntlassen && entlassenCount>0);
  var entlassenToggle = entlassenCount>0
    ? ' \u00b7 '+entlassenCount+' entlassen <span class="bp-entlassen-toggle" data-bp-action="toggle-entlassen">'+(showEntlassen?'ausblenden':'anzeigen')+'</span>'
    : '';
  var rows=sorted.map(function(c){
    var st2=computeStatus(c,today);
    var vE=vorlEntlass(c), ueD=ueGruppe(c), bW=behWochen(c, today);
    var editBtn=canEdit?'<button class="bp-row-action" data-bp-action="edit" data-bp-id="'+h(c.id)+'" title="Bearbeiten">&#x270e;</button>':'';
    var ktCell = h(c.kostenzusage_traeger||'')+(c.kostenzusage_detail?' <span class="bp-kt-detail">('+h(c.kostenzusage_detail)+')</span>':'');
    var kzAblauf='';
    var _kzD=parseISO(c.kostenzusage_bis);
    if(_kzD){ kzAblauf=' <span class="bp-kz-ablauf">('+daysBetween(today,_kzD)+' T)</span>'; }
    // vorl. Entlass: immer computed, nie inline-editierbar
    var vECell = vE ? fmtDate(toISO(vE)) : '<span class="bp-na">—</span>';
    // Status-Badge: VA stellen und VA beantragt sind klickbar
    var statusCell;
    if(st2.code===S.VZUB && canEdit){
      statusCell='<span class="bp-badge bp-badge-click" data-bp-action="set-beantragt" data-bp-id="'+h(c.id)+'" title="Klicken: VA beantragt" style="background:#ffab00;color:#000;cursor:pointer">VA stellen ▶</span>';
    } else if(st2.code===S.VBEA && canEdit){
      statusCell='<span class="bp-badge bp-badge-click" data-bp-action="decide-va" data-bp-id="'+h(c.id)+'" title="Klicken: Entscheidung (bewilligt oder abgelehnt)" style="background:#0052cc;color:#fff;cursor:pointer">VA beantragt ▶</span>';
    } else if(st2.code===S.VABG && canEdit){
      statusCell='<span class="bp-badge bp-badge-click" data-bp-action="decide-abgelehnt" data-bp-id="'+h(c.id)+'" title="Klicken: weiteres Vorgehen nach Ablehnung" style="background:#de350b;color:#fff;cursor:pointer">VA abgelehnt ▶</span>';
    } else if(st2.code===S.VWID && canEdit){
      statusCell='<span class="bp-badge bp-badge-click" data-bp-action="decide-va" data-bp-id="'+h(c.id)+'" title="Klicken: Entscheidung über Widerspruch" style="background:#6554c0;color:#fff;cursor:pointer">Widerspruch ▶</span>';
    } else {
      statusCell=badge(st2);
    }
    // BT-Felder: select wenn Liste konfiguriert (Einstellungen > Macro-Param),
    // sonst inline-text. Listen werden pro Zeile frisch gelesen -> nach dem
    // Speichern der Einstellungen sofort wirksam.
    var _thVL = getThVerbalList(), _thNVL = getThNvList();
    var btVCell = canEdit
      ? (_thVL.length
          ? '<span class="bp-editable" data-bp-action="inline-select" data-bp-id="'+h(c.id)+'" data-bp-field="bt_verbal" data-bp-opts="'+h(_thVL.join('|'))+'">'+h(c.bt_verbal||'—')+'</span>'
          : '<span class="bp-ec" data-bp-action="inline-edit" data-bp-id="'+h(c.id)+'" data-bp-field="bt_verbal" data-bp-type="text">'+h(c.bt_verbal||'—')+'</span>')
      : h(c.bt_verbal||'');
    var btNvCell = canEdit
      ? (_thNVL.length
          ? '<span class="bp-editable" data-bp-action="inline-select" data-bp-id="'+h(c.id)+'" data-bp-field="bt_nonverbal" data-bp-opts="'+h(_thNVL.join('|'))+'">'+h(c.bt_nonverbal||'—')+'</span>'
          : '<span class="bp-ec" data-bp-action="inline-edit" data-bp-id="'+h(c.id)+'" data-bp-field="bt_nonverbal" data-bp-type="text">'+h(c.bt_nonverbal||'—')+'</span>')
      : h(c.bt_nonverbal||'');
    var ctx={st2:st2,vE:vE,ueD:ueD,bW:bW,editBtn:editBtn,ktCell:ktCell,kzAblauf:kzAblauf,
             vECell:vECell,statusCell:statusCell,btVCell:btVCell,btNvCell:btNvCell};
    var cells=COLS.map(function(col){return col.td(c,ctx);}).join('');
    return '<tr class="bp-row bp-row-'+st2.code+'" data-bp-row-id="'+h(c.id)+'">'+
      cells+'<td class="bp-print-only bp-col-rm"></td></tr>';
  }).join('');
  var tbBtns = canEdit
    ? '<span class="bp-titlebar-buttons">'+
      '<button class="bp-btn bp-tb-btn" data-bp-action="add"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 3v10M3 8h10"/></svg>Neue Aufnahme</button>'+
      '<button class="bp-btn bp-tb-btn" data-bp-action="reload" title="Aktualisieren"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 7V3.5L11.5 6A5.5 5.5 0 0 0 2.5 8"/><path d="M2 9v3.5L4.5 10A5.5 5.5 0 0 0 13.5 8"/></svg></button>'+
      '<button class="bp-btn bp-tb-btn" data-bp-action="print"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M4 5V2h8v3"/><rect x="2" y="5" width="12" height="7" rx="1"/><rect x="4" y="9" width="8" height="5"/><circle cx="12" cy="7.5" r="0.5" fill="currentColor" stroke="none"/></svg>Drucken</button>'+
      '<button class="bp-btn bp-tb-btn" data-bp-action="versand"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><rect x="2" y="3.5" width="12" height="9" rx="1"/><path d="M2.5 4.5l5.5 4 5.5-4"/></svg>Versand</button>'+
      '<button class="bp-btn bp-tb-btn" data-bp-action="settings" title="Einstellungen"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><circle cx="8" cy="8" r="2"/><path d="M13 8c0 .4 0 .8-.1 1.2l1.5 1.1-1.4 2.4-1.7-.6c-.6.5-1.3.9-2 1.1L9 15H6.9l-.3-1.8a5 5 0 0 1-2-1.1l-1.7.6L1.4 10.3 3 9.2A6 6 0 0 1 3 6.8L1.4 5.7l1.4-2.4 1.7.6c.6-.5 1.3-.9 2-1.1L6.9 1H9l.3 1.8c.7.2 1.4.6 2 1.1l1.7-.6 1.4 2.4L13 6.8c0 .4.1.8.1 1.2z"/></svg></button>'+
      '</span>'
    : '';
