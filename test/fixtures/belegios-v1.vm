// ── KONKURRENZ: Versions-Polling + Update-Hinweis ────────────────────
// Confluence-eigene Update-Meldungen/kooperatives Bearbeiten greifen NICHT,
// weil die Daten in Content Properties liegen (eigene Version, keine Seiten-
// version, kein Synchrony). Wir pollen daher selbst die Property-Version:
// alle 60s + bei Tab-Fokus, pausiert im Hintergrund. Bei höherer Server-
// version → dezentes Banner. Niemals automatisch überschreiben/neu rendern;
// der Nutzer entscheidet per Klick (lädt dann frisch = korrekter Stand+Version).
var _pollTimer = null;
var _polling   = false;

function isEditing(){
  // Inline-Edit aktiv? (Input/Select mit bp-inline-input in der Tabelle)
  return !!(TABLE_EL && TABLE_EL.querySelector('.bp-inline-input'));
}

function showUpdateBanner(){
  var el = document.getElementById('bp-update-' + instId);
  if(!el){
    el = document.createElement('div');
    el.id = 'bp-update-' + instId;
    el.className = 'bp-update-banner';
    var ref = BANNER_EL || TABLE_EL;
    if(ref && ref.parentNode) ref.parentNode.insertBefore(el, ref);
    else ROOT.insertBefore(el, TABLE_EL);
  }
  el.innerHTML = '<span class="bp-update-text">\u21bb Es gibt neue \u00c4nderungen von einer anderen Person.</span>'+
    '<button class="bp-btn bp-btn-sm" data-bp-action="apply-update">Jetzt aktualisieren</button>';
  el.style.display = 'flex';
}

function hideUpdateBanner(){
  var el = document.getElementById('bp-update-' + instId);
  if(el) el.style.display = 'none';
}

function applyPendingUpdate(){
  // Immer frisch laden → korrekter Stand UND korrekte stateVersion
  // (auch wenn der Nutzer zwischenzeitlich selbst gespeichert hat).
  loadState().then(function(){
    renderTable(state); renderBanner(state);
    hideUpdateBanner(); setStatus('Aktualisiert.');
  }).catch(function(e){ setStatus('Fehler beim Laden: '+(e&&e.message||e), true); });
}

function pollVersion(){
  if(_polling || !pageId || document.hidden) return;
  _polling = true;
  fetch('/rest/api/content/' + pageId + '/property/' + PROP_KEY, {headers:{Accept:'application/json'}})
  .then(function(r){ return r.status === 404 ? null : r.json(); })
  .then(function(j){
    _polling = false;
    if(j && j.version && j.version.number > stateVersion) showUpdateBanner();
  })
  .catch(function(){ _polling = false; });
}

function startPolling(){
  if(_pollTimer) return;
  _pollTimer = setInterval(pollVersion, 60000);          // alle 60s
  document.addEventListener('visibilitychange', function(){
    if(!document.hidden) pollVersion();                  // bei Tab-Fokus sofort
  });
}

// ── ACTIVITY-STREAM-PING (Sprintplan 2b/2c) ───────────────────────────
// Erzeugt eine echte, aber UNSICHTBARE Seitenversion → nativer „Seite
// geändert"-Eintrag im Activity-Stream/Dashboard, korrekt dem Bearbeiter
// zugeordnet (läuft unter dessen Session). Mechanik: ein Anchor-Makro mit
// hochzählender Nummer wird an den Storage-Body ANGEHÄNGT (das Macro selbst
// wird NIE angefasst). Confluence dedupliziert byte-gleiche Edits, daher die
// wechselnde Nummer. Strikt fire-and-forget: blockiert NIE eine Datenänderung;
// gibt nach maxFails still auf. Drosselung + Coalesce + Close-Flush + 409-Schutz.
// HINWEIS: minorEdit:false ist nötig (Major-Edit erscheint im Stream), löst aber
// Watcher-Mails aus → Mail-Unterdrückung instanzseitig lösen (Pitfall 12).
var ACTIVITY = {
  enabled:       true,
  minIntervalMs: 5*60*1000,   // höchstens ~1 Bump / 5 min (Drosselung)
  coalesceMs:    4000,        // Bearbeitungs-Schwung zu EINEM Bump falten
  maxFails:      3,           // nach N Dauerfehlern still aufgeben
  message:       'Belegungsplaner aktualisiert',
  markerPrefix:  'bp-activity-',
  _coalesce:null, _throttle:null, _lastBump:0, _pending:false, _fails:0, _inflight:false
};

function _actCtx(){ return (window.AJS && AJS.contextPath) ? AJS.contextPath() : ''; }

function activityAnchor(n){
  // Anchor-Makro im Storage-Format; rendert unsichtbar.
  return '<ac:structured-macro ac:name="anchor" ac:schema-version="1">'+
         '<ac:parameter ac:name="">'+ACTIVITY.markerPrefix+n+'</ac:parameter>'+
         '</ac:structured-macro>';
}

// Plant einen Bump (Coalesce). Wird NUR aus erfolgreichem Save aufgerufen.
function scheduleActivityBump(){
  if(!ACTIVITY.enabled || !canEdit || ACTIVITY._fails>=ACTIVITY.maxFails) return;
  ACTIVITY._pending = true;
  if(ACTIVITY._coalesce) clearTimeout(ACTIVITY._coalesce);
  ACTIVITY._coalesce = setTimeout(_actThrottled, ACTIVITY.coalesceMs);
}

function _actThrottled(){
  ACTIVITY._coalesce = null;
  var wait = ACTIVITY.minIntervalMs - (Date.now() - ACTIVITY._lastBump);
  if(wait <= 0){ doActivityBump(); return; }
  if(ACTIVITY._throttle) clearTimeout(ACTIVITY._throttle);
  ACTIVITY._throttle = setTimeout(function(){ ACTIVITY._throttle=null; doActivityBump(); }, wait);
}

function doActivityBump(retry){
  retry = retry || 0;
  if(!ACTIVITY._pending || ACTIVITY._inflight) return;
  if(!ACTIVITY.enabled || !canEdit || ACTIVITY._fails>=ACTIVITY.maxFails) return;
  ACTIVITY._inflight = true;
  var base = _actCtx();
  fetch(base + '/rest/api/content/' + pageId + '?expand=body.storage,version,space',
        {headers:{Accept:'application/json'}})
  .then(function(r){ if(!r.ok) throw new Error('GET '+r.status); return r.json(); })
  .then(function(page){
    var body = page.body.storage.value;
    // Marker round-trip-stabil finden: nur die NUMMER ersetzen (Anchor-Struktur
    // unangetastet → übersteht Confluence-Normalisierung). Sonst frisch anhängen.
    var esc = ACTIVITY.markerPrefix.replace(/[-\/\\^$*+?.()|[\]{}]/g,'\\$&');
    var re  = new RegExp(esc + '(\\d+)');
    var m = body.match(re);
    var newBody = m ? body.replace(re, ACTIVITY.markerPrefix + (parseInt(m[1],10)+1))
                    : body + activityAnchor(1);
    var put = {
      id: page.id, type:'page', title: page.title,
      space:{ key: page.space.key },
      body:{ storage:{ value:newBody, representation:'storage' } },
      version:{ number: page.version.number+1, minorEdit:false, message:ACTIVITY.message }
    };
    return fetch(base + '/rest/api/content/' + pageId, {
      method:'PUT',
      headers:{'Content-Type':'application/json','X-Atlassian-Token':'no-check'},
      body: JSON.stringify(put)
    });
  })
  .then(function(r){
    ACTIVITY._inflight = false;
    if(r.status===409 && retry<2){ doActivityBump(retry+1); return; }  // frische Version, erneut
    if(!r.ok) throw new Error('PUT '+r.status);
    ACTIVITY._pending = false;
    ACTIVITY._lastBump = Date.now();
    ACTIVITY._fails = 0;
  })
  .catch(function(e){
    ACTIVITY._inflight = false;
    ACTIVITY._fails++;
    console.warn('[bp] Activity-Bump fehlgeschlagen ('+ACTIVITY._fails+'/'+ACTIVITY.maxFails+'):', e && e.message);
    // fire-and-forget: die fachliche Mutation bleibt unberührt
  });
}

// Close-Flush (Best-Effort): ausstehenden Bump beim Verlassen sofort auslösen
// (umgeht die Drosselung). Keine Garantie bei hartem Tab-Kill — bewusst akzeptiert,
// da die Daten ohnehin sicher persistiert sind.
function flushActivityBump(){
  if(!ACTIVITY._pending || ACTIVITY._fails>=ACTIVITY.maxFails) return;
  if(ACTIVITY._coalesce){ clearTimeout(ACTIVITY._coalesce); ACTIVITY._coalesce=null; }
  if(ACTIVITY._throttle){ clearTimeout(ACTIVITY._throttle); ACTIVITY._throttle=null; }
  doActivityBump();
}

function wireActivityFlush(){
  window.addEventListener('beforeunload', flushActivityBump);
  document.addEventListener('visibilitychange', function(){
    if(document.hidden) flushActivityBump();
  });
}

// Diagnose (Sprintplan 2a): prüft, ob der Thirdparty-Activity-Endpoint auf DIESER
// Instanz nutzbar ist (liefert 201?). Im Browser aufrufbar: _bp[instId].diagnoseActivity()
function diagnoseActivityEndpoint(){
  var base = _actCtx();
  var entry = { username:(window.AJS&&AJS.Meta?AJS.Meta.get('remote-user'):'')||'',
    action:{name:'aktualisierte', key:'updated'},
    object:{url: base + '/pages/viewpage.action?pageId=' + pageId, title:'Belegungsplaner '+instId} };
  return fetch(base + '/rest/activities/1.0/', {
    method:'POST',
    headers:{'Content-Type':'application/vnd.atl.streams.thirdparty+json','X-Atlassian-Token':'no-check'},
    body: JSON.stringify(entry)
  }).then(function(r){
    console.log('[bp] Thirdparty-Activity-Endpoint Status:', r.status,
      r.status===201 ? '→ NUTZBAR' : '→ NICHT nutzbar (Edit-Bump verwenden)');
    return r.status;
  }).catch(function(e){ console.warn('[bp] Diagnose-Fehler:', e && e.message); return -1; });
}

function scheduleMidnightRefresh(){
  var now=new Date(), tom=new Date(now.getFullYear(),now.getMonth(),now.getDate()+1);
  setTimeout(function(){
    loadState().then(function(){renderTable(state);renderBanner(state);scheduleMidnightRefresh();});
  },tom-now);
}

// ── EVENT DELEGATION ──────────────────────────────────────────────────
ROOT.addEventListener('click',function(e){
  var t=e.target;
  // bubble up to find data-bp-action
  while(t&&t!==ROOT&&!t.getAttribute('data-bp-action'))t=t.parentElement;
  if(!t)return;
  var action=t.getAttribute('data-bp-action');
  var id=t.getAttribute('data-bp-id');
  if(!action)return;
  // Overlay click: only close if click is directly on overlay
  if(action==='close-modal'&&t.classList.contains('bp-overlay')&&e.target!==t)return;
  try{
    switch(action){
      case 'add':             openAufnahmeModal(); break;
      case 'print':           openPrintModal(); break;
      case 'confirm-print':   handleConfirmPrint(); break;
      case 'versand':          openVersandModal(); break;
      case 'settings':         openSettingsModal(); break;
      case 'save-settings':    handleSaveSettings(); break;
      case 'selftest':         SELFTEST.run(); break;
      case 'versand-mail':    handleVersandMail(); break;
      case 'reload':          loadState().then(function(){renderTable(state);renderBanner(state);setStatus('Aktualisiert.');}); break;
      case 'toggle-entlassen': showEntlassen=!showEntlassen; renderTable(state); break;
      case 'sort': {
        var sk=t.getAttribute('data-bp-sortkey');
        if(sk){ if(sortKey===sk){ sortDir=(sortDir==='asc'?'desc':'asc'); } else { sortKey=sk; sortDir='asc'; } renderTable(state); }
        break;
      }
      case 'apply-update':    applyPendingUpdate(); break;
      case 'close-modal':     closeModal(); break;
      case 'save-aufnahme':   handleAufnahme(); break;
      case 'edit':            openEditModal(id); break;
      case 'set-beantragt':   applyPatch(id,{verlaengerung_status:'beantragt'}); break;
      case 'set-bewilligt': {
        var cl=state.clients.find(function(x){return x.id===id;}); if(!cl)break;
        if(!cl.verlaengerung_bis){setStatus('Kein Verlängerungsdatum eingetragen.',true);break;}
        applyPatch(id,{kostenzusage_bis:cl.verlaengerung_bis,verlaengerung_bis:null,verlaengerung_status:'genehmigt'});
        break;
      }
      case 'decide-va':        openVaDecisionModal(id); break;       // beantragt/widerspruch → bewilligt|abgelehnt
      case 'va-abgelehnt':     applyPatch(id,{verlaengerung_status:'abgelehnt'}); break;
      case 'decide-abgelehnt': openAbgelehntModal(id); break;        // abgelehnt → Widerspruch|Eigene Kosten|Entlass vorziehen
      case 'va-widerspruch':   applyPatch(id,{verlaengerung_status:'widerspruch'}); break;
      case 'va-eigene-kosten': {  // Entlassdatum bleibt; Detail um "ab DD.MM. SZ" ergänzen
        var clk=state.clients.find(function(x){return x.id===id;}); if(!clk)break;
        var _note=selbstzahlerNote(clk.kostenzusage_bis);
        var _det=clk.kostenzusage_detail||'';
        var _patch={verlaengerung_status:'eigene_kosten'};
        if(_det.indexOf(_note)<0) _patch.kostenzusage_detail=_det?(_det+'; '+_note):_note;
        applyPatch(id,_patch);
        break;
      }
      case 'va-entlass-vorziehen': openEntlassVorziehenModal(id); break;
      case 'va-entlass-vorziehen-confirm': {
        var dv=document.getElementById('bp-ev-d');
        if(!dv||!dv.value){setStatus('Bitte Datum w\u00e4hlen.',true);break;}
        if(!dateInRange(dv.value)){setStatus(dateRangeMsg(),true);break;}
        applyPatch(id,{entlassdatum:dv.value, verlaengerung_status:'keine', verlaengerung_bis:null});
        break;
      }
      case 'inline-select': {
        var field3=t.getAttribute('data-bp-field');
        var opts3=(t.getAttribute('data-bp-opts')||'').split('|').filter(Boolean);
        var cl3=state.clients.find(function(x){return x.id===id;}); if(!cl3)break;
        // Bestandswert erhalten, auch wenn er nicht (mehr) in der Liste steht
        var cur3=cl3[field3]||'';
        if(cur3 && opts3.indexOf(cur3)<0) opts3.push(cur3);
        var sel=document.createElement('select');
        sel.className='bp-inline-input';
        sel.innerHTML='<option value="">—</option>'+opts3.map(function(o){
          return '<option value="'+h(o)+'"'+(o===cl3[field3]?' selected':'')+'>'+h(o)+'</option>';
        }).join('');
        t.replaceWith(sel); sel.focus();
        sel.addEventListener('change',function(){
          mutate(id, function(client){ client[field3]=sel.value||null; });
        });
        sel.addEventListener('blur',function(){renderTable(state);});
        break;
      }
      case 'inline-toggle':   handleInlineToggle(id, t.getAttribute('data-bp-field')); break;
      case 'inline-edit': {
        var field2 = t.getAttribute('data-bp-field');
        var type2  = t.getAttribute('data-bp-type');
        // find the actual td (might be the span or the td itself)
        var td2 = t.tagName==='TD' ? t : t.closest('td');
        if (td2) handleInlineEdit(td2, id, field2, type2);
        break;
      }
      case 'save-edit':       handleEdit(id); break;
      case 'delete-client':   handleDelete(id); break;
      case 'quick-verlaengern':         openQuickVerlaengernModal(id); break;
      case 'quick-entlassen':           openQuickEntlassenModal(id); break;
      case 'confirm-quick-verlaengern': handleQuickVerlaengern(id); break;
      case 'confirm-quick-entlassen':   handleQuickEntlassen(id); break;
    }
  }catch(err){console.error('[bp]',err);setStatus(err.message,true);}
});

// ── INIT ──────────────────────────────────────────────────────────────
function init(){
  console.log('[bp]', instId, 'init start, pageId=', pageId);
  fetchTinyLink();   // nicht blockierend — Fallback greift, bis er da ist
  Promise.all([checkCanEdit(),loadState()]).then(function(){
    applyAuthUI();
    checkAdminGroup().then(function(a){ isAdmin=a; applyAdminUI(); });
    renderTable(state);
    renderBanner(state);
    applyViewCSS();
    scheduleMidnightRefresh();
    startPolling();
    wireActivityFlush();
    setStatus('');
    wireSelftestButton();
  }).catch(function(e){console.error('[bp]', instId, 'init error', e); setStatus('Fehler beim Laden: '+(e&&e.message||e),true);});
}

// Module-Export für Erweiterungen (Sprint 6+)
window._bp=window._bp||{};
window._bp[instId]={
  loadState:loadState, saveState:saveState,
  getState:function(){return state;},
  canEdit:function(){return canEdit;},
  getPermaLink:getPermaLink, getLongLink:getLongLink, fetchTinyLink:fetchTinyLink,
  getThVerbalList:getThVerbalList, getThNvList:getThNvList,
  paramThVerbalList:paramThVerbalList, paramThNvList:paramThNvList,
  refresh:function(){renderTable(state);renderBanner(state);},
  activity:ACTIVITY, diagnoseActivity:diagnoseActivityEndpoint
};

init();

})();
//]]>
</script>
<details class="bp-guide">
<summary class="bp-guide-summary">&hellip; Anleitung</summary>
<div class="bp-guide-body">

<h4>Neue Aufnahme</h4>
<ol>
  <li>Schaltfl&auml;che <strong>+ Neue Aufnahme</strong> klicken.</li>
  <li>Formular ausf&uuml;llen: Name, Aufnahmedatum, Kostentr&auml;ger, Kostenzusage&nbsp;bis&nbsp;(Datum), ggf.&nbsp;Detail, <strong>Wahlleistung</strong>, Bezugstherapeuten (verbal/non-verbal).</li>
  <li><strong>Aufnehmen</strong> klicken &mdash; System berechnet automatisch vorl.&nbsp;Entlassdatum und &Uuml;-Gruppe&nbsp;Datum.</li>
</ol>

<h4>Felder direkt bearbeiten (In-Place)</h4>
<p>Klick auf eine Zelle &ouml;ffnet ein Eingabefeld direkt in der Tabelle:<br>
<strong>Enter</strong> speichert &mdash; <strong>Escape</strong> verwirft &mdash; <strong>Klick ausserhalb</strong> speichert.<br>
Nicht editierbar: <em>vorl.&nbsp;Entlassdatum</em> und <em>&Uuml;-Gruppe&nbsp;Datum</em> (werden automatisch berechnet).</p>

<h4>Verl&auml;ngerungsantrag</h4>
<ol>
  <li>Klient &ouml;ffnen (&#x270e;) &rarr; <em>Verl&auml;ngerung bis</em>&nbsp;Datum eintragen &rarr; Speichern.<br>
      &rArr; Badge&nbsp;<strong>VA&nbsp;stellen</strong> erscheint automatisch.</li>
  <li>Antrag abgeschickt? Badge <strong>VA&nbsp;stellen&nbsp;&#x25b6;</strong> klicken &rarr; wird zu <strong>VA&nbsp;beantragt</strong>.</li>
  <li>Kostenzusage erhalten? Badge <strong>VA&nbsp;beantragt&nbsp;&#x25b6;</strong> klicken &rarr; Kostenzusage wird auf Verl&auml;ngerungsdatum gesetzt, Status <strong>VA&nbsp;bewilligt</strong>.</li>
</ol>

<h4>Entscheidungs-Frist (Vorlauf)</h4>
<p>Liegt das vorl.&nbsp;Entlassdatum weniger als <em>X</em>&nbsp;Tage entfernt und ist weder ein Verl&auml;ngerungsantrag noch ein Entlassdatum eingetragen, erscheint das Badge <strong>Entscheidung</strong> (orange) &mdash; ist das Datum bereits &uuml;berschritten, wird es <strong>&uuml;berf&auml;llig</strong> (rot). Das Banner oben listet alle betroffenen Klienten mit Schnell-Aktionen.</p>
<p>Der Vorlauf <em>X</em> ist einstellbar (Standard: 17&nbsp;Tage) &mdash; siehe <strong>Einstellungen</strong>. Der aktuell eingestellte Wert steht in der Titelzeile (&bdquo;&hellip;&nbsp;Tage Vorlauf&ldquo;).</p>

<h4>Entlassung</h4>
<ol>
  <li>Klient &ouml;ffnen (&#x270e;) &rarr; <em>Entlassdatum (final)</em> eintragen &rarr; Speichern.<br>
      &rArr; Das <strong>Entscheidung</strong>-Badge entf&auml;llt. Ab 6&nbsp;Tagen vor dem Entlassdatum wird die Zeile grau (&Uuml;-Gruppe-Phase &mdash; eine volle Woche, sodass jeder Wochentag Mo&ndash;Fr einmal besucht wird).</li>
  <li>Nach Ablauf des Entlassdatums verschwindet die Zeile automatisch aus der Liste.</li>
</ol>

<h4>Kapazit&auml;t</h4>
<p>Regelkapazit&auml;t: <strong>9 aktive Klienten</strong> (ohne &Uuml;-Gruppe). &Uuml;-Gruppe-Teilnehmer belegen keinen Platz mehr. Ausnahmsweise bis zu 10 m&ouml;glich.</p>

<h4>Einstellungen</h4>
<ol>
  <li>Zahnrad-Schaltfl&auml;che <strong>&#9881;</strong> (Titelzeile) klicken.</li>
  <li><em>Entscheidungsgrenze (Tage)</em> festlegen &mdash; ab wie vielen Tagen vor dem vorl.&nbsp;Entlassdatum das <strong>Entscheidung</strong>-Badge erscheint (1&ndash;365, Standard&nbsp;17).</li>
  <li><em>Bezugstherapeut:innen &mdash; verbal / non-verbal</em> pflegen: Namen mit <strong>Komma</strong> trennen (Semikolon geht auch).<br>
      &rArr; Gepflegte Listen erscheinen als <strong>Auswahlfeld</strong> in Aufnahme, Bearbeiten und direkt in der Tabelle. Leere Liste&nbsp;&rarr; Freitext-Eingabe.</li>
  <li><strong>Speichern</strong> &mdash; Statusberechnung, Banner und Auswahllisten aktualisieren sich sofort.</li>
</ol>
<p><strong>Hinweis zu den Macro-Parametern:</strong> Die Parameter <em>TherapeutenVerbal</em> / <em>TherapeutenNonVerbal</em> sind <em>veraltet</em>, funktionieren aber weiterhin.
Solange die Einstellung nie gespeichert wurde, gelten die Parameter; der Dialog ist damit vorbelegt.
Nach dem ersten Speichern hat die <strong>Einstellung Vorrang</strong> &mdash; auch wenn sie bewusst leer gelassen wird.
Bereits zugeordnete Namen bleiben in jedem Fall erhalten, selbst wenn sie nicht mehr in der Liste stehen.</p>

<h4>Drucken / PDF</h4>
<ol>
  <li>Schaltfl&auml;che <strong>&#128438;&nbsp;Drucken</strong> klicken.</li>
  <li>Gew&uuml;nschte Spalten ausw&auml;hlen (Auswahl wird gespeichert).</li>
  <li>Im Browser-Druckdialog <em>Als PDF speichern</em> w&auml;hlen.</li>
</ol>

<h4>Versand</h4>
<ol>
  <li>Schaltfl&auml;che <strong>&#9993;&nbsp;Versand</strong> klicken.</li>
  <li>Empf&auml;nger, Betreff und Nachricht pr&uuml;fen &mdash; die Angaben werden als Vorlage gespeichert.</li>
  <li><em>Mail&nbsp;&ouml;ffnen</em> &mdash; das Mail-Programm startet mit vorbef&uuml;lltem Empf&auml;nger, Betreff und Text und senden.</li>
</ol>
<p>Versendet wird der <strong>Link</strong>, kein PDF-Anhang &mdash; Empf&auml;nger:innen sehen darüber immer den aktuellen Stand.
Ein PDF l&auml;sst sich weiterhin jederzeit &uuml;ber <strong>&#128438;&nbsp;Drucken</strong> in der Titelzeile erzeugen.</p>
<p>Verwendet wird der <strong>Kurzlink</strong> aus dem Confluence-Teilen-Dialog (Form <code>&hellip;/x/44RIAg</code>), den das Macro &uuml;ber die REST-Schnittstelle abruft.
Er bleibt g&uuml;ltig, wenn die Seite umbenannt oder verschoben wird; der Anker dahinter springt direkt zur jeweiligen Gruppe.
Steht der Kurzlink ausnahmsweise nicht zur Verf&uuml;gung, wird automatisch die lange <em>pageId</em>-URL eingesetzt &mdash; dasselbe Ziel.
Er steht als normaler Text in der Nachricht und kann verschoben oder gel&ouml;scht werden. Bereits gespeicherte Vorlagen werden beim n&auml;chsten &Ouml;ffnen einmalig um den Link erg&auml;nzt.</p>

</div>
</details>
