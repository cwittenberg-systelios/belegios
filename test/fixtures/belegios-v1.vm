function handleConfirmPrint(){
  state.printCols=readColToggles('bp-print-col-cb');
  saveState(state, {replay: replaySetTop({printCols: state.printCols})}).catch(function(){});
  var dInp=document.getElementById('bp-print-date');
  var todayIso=toISO(new Date());
  // Nur wenn ein abweichendes, gültiges Datum gewählt wurde → Stichtags-Vorschau.
  var asOf=(dInp && dInp.value && dInp.value!==todayIso && dateInRange(dInp.value)) ? dInp.value : null;
  applyPrintCSS();
  closeModal();
  printView(asOf);
}

function printView(asOf){
  // Dateiname = Macro-Titel + (Stichtags-)Datum
  var origTitle = document.title;
  var d = asOf ? new Date(asOf+'T00:00:00') : new Date();
  var dd = String(d.getDate()).padStart(2,'0');
  var mm = String(d.getMonth()+1).padStart(2,'0');
  var dateStr = dd+'.'+mm+'.'+d.getFullYear();
  document.title = 'Belegungsplaner '+instId+'_'+dateStr;
  if(asOf) renderTable(state, asOf);   // Stichtags-Vorschau: Status/Fristen/Teilnehmer zum Datum
  var restored = false;
  function restore(){ if(restored)return; restored=true; document.title = origTitle; if(asOf) renderTable(state); }
  window.addEventListener('afterprint', restore, {once:true});
  setTimeout(restore, 2000); // Fallback falls afterprint nicht feuert
  requestAnimationFrame(function(){window.print();});
}

