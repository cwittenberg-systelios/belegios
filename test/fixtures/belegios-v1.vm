    openAufnahmeModal();
    var amHtml = MODAL_EL.innerHTML;
    t.log('Regression','Aufnahme-Modal: kein "NaN" im HTML', amHtml.indexOf('NaN')<0);
    t.log('Regression','Aufnahme-Modal: Label "Aufnahmedatum" vorhanden', amHtml.indexOf('>Aufnahmedatum ')>=0);
    var amO=(amHtml.split('<div').length-1), amC=(amHtml.split('</div>').length-1);
    t.log('Regression','Aufnahme-Modal: Divs balanciert ('+amO+'/'+amC+')', amO===amC);
    t.log('Regression','Aufnahme-Modal: Footer-Button save-aufnahme vorhanden', amHtml.indexOf('save-aufnahme')>=0);
    closeModal();

    // [Inline-Edit Datum] native date-Inputs feuern 'change' (nicht zuverlässig 'blur');
