// Detail-Elemente innerhalb von Zellen (keine eigene Spalte) — separat ab-/anwählbar,
// in Anzeige (Einstellungen) UND Druck (Druckdialog).
var SUBCOLS = [
  {key:'kt_detail', label:'Kostenträger-Detail', css:'.bp-kt-detail'},
  {key:'kz_ablauf', label:'Ablauf Kostenzusage', css:'.bp-kz-ablauf'}
];

// Sammelt CSS-Regeln für ABGEWÄHLTE Spalten + Detail-Elemente.
// isPrint=true → Druck-Defaults (col.def); isPrint=false (Anzeige) → Default alles sichtbar.
function collectHideRules(sel, isPrint){
  sel=sel||{};
  var rules=[];
  COLS.forEach(function(col){
    if(col.always)return;
    var def = isPrint ? (col.def!==false) : (col.defView!==false);
    var on = sel.hasOwnProperty(col.key) ? !!sel[col.key] : def;
    if(!on) rules.push('.bp-root .bp-col-'+col.idx+'{display:none !important}');
  });
  SUBCOLS.forEach(function(sc){
    var on = sel.hasOwnProperty(sc.key) ? !!sel[sc.key] : true;
    if(!on) rules.push('.bp-root '+sc.css+'{display:none !important}');
  });
  return rules.join('');
}

function buildColToggles(sel, isPrint, cbClass){
  sel=sel||{};
  var st='style="width:48%;display:inline-flex;margin-bottom:4px"';
  var out=[];
  COLS.forEach(function(col){
    if(col.always){
      out.push('<label class="bp-checkbox-label" '+st+'><input type="checkbox" class="'+cbClass+'" data-col-key="'+col.key+'" disabled checked> '+h(col.label)+'</label>');
      return;
    }
    var def = isPrint ? (col.def!==false) : (col.defView!==false);
    var on = sel.hasOwnProperty(col.key) ? !!sel[col.key] : def;
    out.push('<label class="bp-checkbox-label" '+st+'><input type="checkbox" class="'+cbClass+'" data-col-key="'+col.key+'"'+(on?' checked':'')+'> '+h(col.label)+'</label>');
  });
  SUBCOLS.forEach(function(sc){
    var on = sel.hasOwnProperty(sc.key) ? !!sel[sc.key] : true;
    out.push('<label class="bp-checkbox-label" '+st+'><input type="checkbox" class="'+cbClass+'" data-col-key="'+sc.key+'"'+(on?' checked':'')+'> '+h(sc.label)+'</label>');
  });
  return out.join('');
}

function readColToggles(cbClass){
  var sel={};
  MODAL_EL.querySelectorAll('.'+cbClass).forEach(function(cb){
    sel[cb.getAttribute('data-col-key')]=cb.checked;
  });
  return sel;
}

