    // ── Zukünftige Aufnahmen + Stichtags-Rechnung ──
    var futC={id:'fut1', aufnahmedatum:da(30), kostenzusage_bis:da(200), verlaengerung_status:'keine'};
    t.assertEq('Unit','Zukunfts-Aufnahme → Status „Geplant"', computeStatus(futC, fix.today).code, S.GEPLANT);
    t.log('Unit','Zukunfts-Aufnahme: behWochen null', behWochen(futC, fix.today)===null);
    t.log('Unit','Aufnahme heute → nicht geplant', computeStatus({id:'h',aufnahmedatum:da(0)}, fix.today).code!==S.GEPLANT);
    var nineA=[]; for(var gi=0;gi<9;gi++) nineA.push({id:'na'+gi,aufnahmedatum:da(-30),kostenzusage_bis:da(200),verlaengerung_status:'keine'});
    t.assertEq('Unit','Kapazität: geplante Aufnahme zählt NICHT (=9)', getActiveCount(nineA.concat([futC]), fix.today), 9);
    var asof40=(function(){var x=new Date(fix.today); x.setDate(x.getDate()+40); return sod(x);})();
    t.assertEq('Unit','Stichtag +40: geplante Aufnahme nun aktiv (=10)', getActiveCount(nineA.concat([futC]), asof40), 10);
    t.log('Unit','Stichtag +40: nicht mehr „Geplant"', computeStatus(futC, asof40).code!==S.GEPLANT);

    // ── Ablehnungs-Flow: abgelehnt / Widerspruch / eigene Kosten ──
    function vaBase(extra){return Object.assign({aufnahmedatum:da(-60),kostenzusage_traeger:'PKV',kostenzusage_bis:da(120)},extra||{});}
    t.assertEq('Unit','Status: abgelehnt → „VA abgelehnt"', computeStatus(vaBase({verlaengerung_status:'abgelehnt'}), fix.today).code, S.VABG);
    t.assertEq('Unit','Status: widerspruch → „Widerspruch"', computeStatus(vaBase({verlaengerung_status:'widerspruch'}), fix.today).code, S.VWID);
    t.assertEq('Unit','Status: eigene_kosten → „Eigene Kosten"', computeStatus(vaBase({verlaengerung_status:'eigene_kosten'}), fix.today).code, S.VEK);
    t.assertEq('Unit','Ablehnung + nahe Entlassung → VA abgelehnt (nicht ENT)',
      computeStatus(vaBase({verlaengerung_status:'abgelehnt',kostenzusage_bis:da(10)}), fix.today).code, S.VABG);
    t.log('Unit','SZ unterdrückt „VA abgelehnt"',
      computeStatus(vaBase({kostenzusage_traeger:'SZ',verlaengerung_status:'abgelehnt'}), fix.today).code!==S.VABG);
    t.log('Unit','Dropdown enthält neue VA-Status (Edit-Modal)',
      ['abgelehnt','widerspruch','eigene_kosten'].every(function(k){return STATUS_META['verl_'+(k==='eigene_kosten'?'eigene_kosten':k)];}));
    t.assertEq('Unit','Eigene Kosten: Detail-Notiz „ab DD.MM. SZ"', selbstzahlerNote('2026-08-14'), 'ab 15.08. SZ');
    t.assertEq('Unit','Eigene Kosten: Jahreswechsel 31.12.→01.01.', selbstzahlerNote('2026-12-31'), 'ab 01.01. SZ');
    t.log('Unit','Eigene Kosten: ohne Kostenzusage → „SZ"', selbstzahlerNote('')==='SZ');

    // ════════════ REGRESSION: in dieser Session gefundene & behobene Fehler ════════════
    var dd = function(off){ var x=new Date(fix.today); x.setDate(x.getDate()+off); return toISO(x); };

    // [behWochen] Aktuelle (laufende) Behandlungswoche: Aufnahmetag = Woche 1, +7 Tage = Woche 2.
    // Bug war: zeigte geplante Gesamtdauer (Aufnahme→vorl. Entlass) statt laufender Woche.
    t.assertEq('Regression','behWochen: Aufnahme heute → Woche 1', behWochen({aufnahmedatum:dd(0)}, fix.today), 1);
    t.assertEq('Regression','behWochen: Aufnahme -6 Tage → Woche 1', behWochen({aufnahmedatum:dd(-6)}, fix.today), 1);
    t.assertEq('Regression','behWochen: Aufnahme -7 Tage → Woche 2', behWochen({aufnahmedatum:dd(-7)}, fix.today), 2);
    t.assertEq('Regression','behWochen: Aufnahme -14 Tage → Woche 3', behWochen({aufnahmedatum:dd(-14)}, fix.today), 3);
    t.assertEq('Regression','behWochen: vorl. Entlass irrelevant', behWochen({aufnahmedatum:dd(-6), kostenzusage_bis:dd(30)}, fix.today), 1);
    t.assertEq('Regression','behWochen: kein Aufnahmedatum → null', behWochen({aufnahmedatum:null}, fix.today), null);

    // [computeStatus] Ü-Gruppe schließt den Entlasstag SELBST ein (eD>=today, nicht eD>today).
    // Bug war: Entlasstag=heute fiel weder auf entlassen noch in_ue_gruppe → zählte fälschlich mit.
    var dToday = {aufnahmedatum:dd(-40), kostenzusage_bis:dd(1), verlaengerung_bis:dd(28),
                  verlaengerung_status:'keine', entlassdatum:dd(0), kein_ue_gruppe:false};
    t.assertEq('Regression','Entlasstag HEUTE → in_ue_gruppe (nicht VA stellen)', computeStatus(dToday, fix.today).code, 'in_ue_gruppe');
    var dTomorrow = JSON.parse(JSON.stringify(dToday)); dTomorrow.entlassdatum=dd(1);
    t.assertEq('Regression','Entlasstag morgen → in_ue_gruppe', computeStatus(dTomorrow, fix.today).code, 'in_ue_gruppe');
    var dYesterday = JSON.parse(JSON.stringify(dToday)); dYesterday.entlassdatum=dd(-1);
    t.assertEq('Regression','Entlasstag gestern → entlassen', computeStatus(dYesterday, fix.today).code, 'entlassen');

    // [getActiveCount] Klient mit Entlasstag=heute zählt NICHT mehr ins Kontingent.
    var nineAct = [];
    for(var ri=0; ri<9; ri++) nineAct.push({id:'rg'+ri, aufnahmedatum:dd(-20), kostenzusage_bis:dd(60), verlaengerung_status:'keine'});
    t.assertEq('Regression','getActiveCount: Entlasstag-heute ausgeschlossen (9, nicht 10)',
               getActiveCount(nineAct.concat([dToday])), 9);

    // [dateInRange] Datums-Plausibilität: nur aktuelles Jahr ±1 (Tippfehler wie '0002' ablehnen).
    var ny = new Date().getFullYear();
    t.assertEq('Regression','dateInRange: aktuelles Jahr gültig', dateInRange(ny+'-07-10'), true);
    t.assertEq('Regression','dateInRange: Vorjahr gültig', dateInRange((ny-1)+'-01-01'), true);
    t.assertEq('Regression','dateInRange: Folgejahr gültig', dateInRange((ny+1)+'-12-31'), true);
    t.assertEq('Regression','dateInRange: Tippfehler 0002 abgelehnt', dateInRange('0002-07-10'), false);
    t.assertEq('Regression','dateInRange: +2 Jahre abgelehnt', dateInRange((ny+2)+'-01-01'), false);
    t.assertEq('Regression','dateInRange: leer → false', dateInRange(''), false);

    // [Selbstzahler] SZ → keine VA-Status (VA stellen / beantragt / bewilligt); 'Entscheidung' bleibt.
    var szB={aufnahmedatum:ddi(-60), kostenzusage_bis:ddi(120)};
    t.assertEq('Regression','SZ + verl_bis → NICHT „VA stellen"',
      computeStatus(Object.assign({},szB,{kostenzusage_traeger:'SZ',verlaengerung_bis:ddi(30),verlaengerung_status:'keine'})).code!==S.VZUB, true);
    t.assertEq('Regression','SZ + genehmigt → NICHT „VA bewilligt"',
      computeStatus(Object.assign({},szB,{kostenzusage_traeger:'SZ',verlaengerung_status:'genehmigt'})).code!==S.VGEH, true);
    t.assertEq('Regression','SZ + beantragt → NICHT „VA beantragt"',
      computeStatus(Object.assign({},szB,{kostenzusage_traeger:'SZ',verlaengerung_status:'beantragt'})).code!==S.VBEA, true);
    t.assertEq('Regression','PKV + verl_bis → „VA stellen" (unverändert)',
      computeStatus(Object.assign({},szB,{kostenzusage_traeger:'PKV',verlaengerung_bis:ddi(30),verlaengerung_status:'keine'})).code, S.VZUB);
    t.assertEq('Regression','PKV + genehmigt → „VA bewilligt" (unverändert)',
      computeStatus(Object.assign({},szB,{kostenzusage_traeger:'PKV',verlaengerung_status:'genehmigt'})).code, S.VGEH);
  },

  // ──────────────────────── INTEGRATION ────────────────────────
  runIntegration: function(fix){
    var t = this;

    // Frische Fixture-State installieren
    state = JSON.parse(JSON.stringify(fix.state));
    renderTable(state);

    // ── Test: echter Klick auf VZUB-Badge "VA stellen" ──
    // (testet Event-Delegation + applyPatch + Status-Transition)
    state = JSON.parse(JSON.stringify(fix.state));
    state.clients.find(function(c){return c.id==='fx_vzub';}).updatedAt = undefined;
    renderTable(state);
    var badge = ROOT.querySelector('[data-bp-action="set-beantragt"][data-bp-id="fx_vzub"]');
    t.log('Integration','set-beantragt: Badge in DOM auffindbar', !!badge);
    if(badge){
      var beforeCalls = SELFTEST.recorders.saveCalls;
      badge.dispatchEvent(new MouseEvent('click', {bubbles:true, cancelable:true}));
      var after = state.clients.find(function(c){return c.id==='fx_vzub';});
      t.assertEq('Integration','Klick: verlaengerung_status → beantragt', after.verlaengerung_status, 'beantragt');
      t.assertEq('Integration','Klick: saveState wurde aufgerufen', SELFTEST.recorders.saveCalls, beforeCalls+1);
      // Status nach dem Klick
      t.assertEq('Integration','Status nach Klick: verl_beantragt', computeStatus(after, fix.today).code, 'verl_beantragt');
    }

    // ── Test: Einstellungsdialog — Therapeuten-Felder vorbelegt + Speichern ──
    state = JSON.parse(JSON.stringify(fix.state));
    var _ibakPV=paramThVerbalList.slice();
    paramThVerbalList=['Anna','Bert'];
    delete state.config.thVerbal; delete state.config.thNonverbal;
    openSettingsModal();
    var thvIn=document.getElementById('bp-s-thv');
    t.log('Integration','Einstellungen: Feld Therapeuten verbal vorhanden', !!thvIn);
    if(thvIn){
      t.assertEq('Integration','Einstellungen: vorbelegt aus Macro-Parameter (kommasepariert)',
                 thvIn.value, 'Anna, Bert');
      t.log('Integration','Einstellungen: einzeiliges Textfeld (kein Textarea)',
            thvIn.tagName==='INPUT' && thvIn.type==='text');
      thvIn.value='Anna, Bert, Carla';
      handleSaveSettings();
      t.assertEq('Integration','Einstellungen: Speichern schreibt config.thVerbal',
                 (state.config.thVerbal||[]).join(','), 'Anna,Bert,Carla');
      t.assertEq('Integration','Einstellungen: Settings gewinnen nach dem Speichern',
                 getThVerbalList().join(','), 'Anna,Bert,Carla');
    }
    closeModal();
    paramThVerbalList=_ibakPV;
    renderTable(state);

    // ── Test: Versand-Dialog — Permalink im Nachrichtentext ──
    state = JSON.parse(JSON.stringify(fix.state));
    state.mailTemplate = {};
    openVersandModal();
    var vBody=document.getElementById('bp-v-body');
    t.log('Integration','Versand: Nachrichtenfeld vorhanden', !!vBody);
    if(vBody) t.log('Integration','Versand: Permalink im Default-Text',
                    vBody.value.indexOf(getPermaLink())>=0);
    t.log('Integration','Versand: Permalink als klickbarer Hinweis im Dialog',
          !!MODAL_EL.querySelector('a.bp-perma-link'));
    t.log('Integration','Versand: keine Schritt-Anleitung mehr im Dialog',
          !MODAL_EL.querySelector('.bp-versand-steps'));
    t.log('Integration','Versand: kein PDF-drucken-Button mehr',
          !MODAL_EL.querySelector('[data-bp-action="versand-print"]'));
    t.log('Integration','Drucken bleibt in der Titelzeile erreichbar',
          !!ROOT.querySelector('[data-bp-action="print"]'));
    closeModal();

    // Gespeicherte Vorlage ohne Link wird einmalig ergänzt
    state.mailTemplate = {to:'x@y.de', subject:'Alt', body:'Hallo,\n\nanbei.\n\nBeste Grüße'};
    openVersandModal();
    var vBody2=document.getElementById('bp-v-body');
    if(vBody2){
      t.log('Integration','Versand: alte Vorlage um Permalink ergänzt',
            vBody2.value.indexOf(getPermaLink())>=0);
      t.log('Integration','Versand: eigener Vorlagentext bleibt erhalten',
            vBody2.value.indexOf('anbei.')>=0 && vBody2.value.indexOf('Beste Grüße')>=0);
    }
    closeModal();

    // Alte Vorlage mit Anker: Anker wird entfernt, kein zweiter Block
    state.mailTemplate = {to:'x@y.de', body:'Hallo.\n\n'+LINK_LABEL+'\n'+getLongLink()+linkAnchor()+'\n\nBeste Grüße'};
    openVersandModal();
    var vBody3=document.getElementById('bp-v-body');
    if(vBody3){
      t.log('Integration','Versand: alter Anker aus Vorlage entfernt',
            vBody3.value.indexOf(linkAnchor())<0);
      t.log('Integration','Versand: kein zweiter Link-Block',
            vBody3.value.split(LINK_LABEL).length===2);
    }
    closeModal();
    state.mailTemplate = {};
    renderTable(state);

    // ── Test: Kurzlink-Auswertung der REST-Antwort (ohne echten Call) ──
    var _bakTiny=tinyLink, _bakFetch=window.fetch;
    tinyLink='';
    var _longBefore=getPermaLink();
    window.fetch=function(){ return Promise.resolve({ok:true, json:function(){
      return Promise.resolve({_links:{base:'http://intranet.example/c', tinyui:'/x/44RIAg'}});
    }}); };
    var _asyncDone=false;
    fetchTinyLink().then(function(){
      _asyncDone=true;
      t.log('Integration','Kurzlink: aus _links.base + _links.tinyui gebaut',
            tinyLink==='http://intranet.example/c/x/44RIAg');
      t.log('Integration','Kurzlink: getPermaLink nutzt ihn ohne Anker',
            getPermaLink()==='http://intranet.example/c/x/44RIAg');
      t.log('Integration','Kurzlink: lange Form bleibt als Variante erkannt',
            bodyHasLink('alt: '+_longBefore));
      window.fetch=_bakFetch; tinyLink=_bakTiny;
    });
    t.log('Integration','Kurzlink: Abruf blockiert die UI nicht', _asyncDone===false);

    // ── Test: applyPatch ändert Feld + Re-Render produziert DOM ──
    state = JSON.parse(JSON.stringify(fix.state));
    renderTable(state);
    var beforeName = state.clients[0].name;
    applyPatch('fx_stab', {name:'Geänderter Name'});
    t.assertEq('Integration','applyPatch: Name geändert', state.clients[0].name, 'Geänderter Name');
    t.assertEq('Integration','applyPatch: nicht der originale Name', state.clients[0].name===beforeName, false);
    var rowAfter = ROOT.querySelector('tr[data-bp-row-id="fx_stab"]');
    t.log('Integration','applyPatch: Zeile rendert nach Patch', !!rowAfter);

    // ── Test: Aufnahme — neuer Klient in state.clients ──
    state = JSON.parse(JSON.stringify(fix.state));
    renderTable(state);
    var origCount = state.clients.length;
    state.clients.push({id:'fx_added', name:'Fx Hinzugefügt', aufnahmedatum:fix.state.clients[0].aufnahmedatum,
                        kostenzusage_traeger:'PKV', kostenzusage_traeger_detail:'',
                        kostenzusage_bis:'', verlaengerung_bis:'', verlaengerung_status:'keine',
                        vorl_entlassdatum:'', entlassdatum:'', kein_ue_gruppe:false, goae:false,
                        bt_verbal:'', bt_nonverbal:''});
    renderTable(state);
    t.assertEq('Integration','Aufnahme: clients.length +1', state.clients.length, origCount+1);
    var rowAdded = ROOT.querySelector('tr[data-bp-row-id="fx_added"]');
    t.log('Integration','Aufnahme: neue Zeile im DOM', !!rowAdded);

    // ── Test: set-bewilligt — VBEA → VGEH Transition ──
    // Manueller Action-Pfad (keine 'set-bewilligt'-Buttons in dieser Variante,
    // aber der Workflow ist in handleSetBewilligt / applyPatch identisch)
    state = JSON.parse(JSON.stringify(fix.state));
    renderTable(state);
    var vbeaCl = state.clients.find(function(c){return c.id==='fx_vbea';});
    var origVerlBis = vbeaCl.verlaengerung_bis;
    applyPatch('fx_vbea', {
      kostenzusage_bis: vbeaCl.verlaengerung_bis,
      verlaengerung_bis: null,
      verlaengerung_status: 'genehmigt'
    });
    var vbeaAfter = state.clients.find(function(c){return c.id==='fx_vbea';});
    t.assertEq('Integration','set-bewilligt: kz_bis = ehemals verl_bis', vbeaAfter.kostenzusage_bis, origVerlBis);
    t.assertEq('Integration','set-bewilligt: verl_bis null', vbeaAfter.verlaengerung_bis, null);
    t.assertEq('Integration','set-bewilligt: status genehmigt', vbeaAfter.verlaengerung_status, 'genehmigt');
    t.assertEq('Integration','set-bewilligt: Status nach Transition → VGEH',
               computeStatus(vbeaAfter, fix.today).code, 'verl_genehmigt');

    // ── Test: DOM-Konsistenz — thead bp-col-N matcht tbody bp-col-N ──
    state = JSON.parse(JSON.stringify(fix.state));
    renderTable(state);
    var theadThs = ROOT.querySelectorAll('.bp-table thead tr:not(.bp-titlebar-row) th');
    var firstTbodyTds = ROOT.querySelectorAll('.bp-table tbody tr:first-child td');
    var indexMismatch = null;
    function colN(el){
      var m=(el.className||'').match(/bp-col-(\d+)/);
      return m?m[1]:null;
    }
    if(theadThs.length===firstTbodyTds.length){
      for(var i=0;i<theadThs.length;i++){
        var h=colN(theadThs[i]); var d=colN(firstTbodyTds[i]);
        if(h!==d){indexMismatch='Position '+i+': th='+h+' vs td='+d;break;}
      }
    }else{
      indexMismatch='Anzahl Spalten verschieden: thead='+theadThs.length+', tbody='+firstTbodyTds.length;
    }
    t.log('Integration','Spalten-Mapping thead bp-col-N = tbody bp-col-N',
          indexMismatch===null, indexMismatch||'');

    // ── Test: Titelzeile vorhanden + rotes Hintergrund (CSS-Specificity) ──
    var titlebar = ROOT.querySelector('tr.bp-titlebar-row th');
    t.log('Integration','Titelzeile im DOM', !!titlebar);
    if(titlebar){
      var bg = window.getComputedStyle(titlebar).backgroundColor;
      // rgb(151, 19, 33) erwartet
      var isRed = bg==='rgb(151, 19, 33)' || /151,\s*19,\s*33/.test(bg);
      t.log('Integration','Titelzeile: rotes Brand-Hintergrund (CSS-Override greift)',
            isRed, bg);
    }

    // ── Test: Logo embedded — Data-URI vorhanden, kein externer Fetch ──
    var logo = ROOT.querySelector('.bp-titlebar-logo');
    t.log('Integration','Logo im DOM', !!logo);
    if(logo){
      var src = logo.getAttribute('src')||'';
      t.log('Integration','Logo: data:image/svg+xml (eingebettet, kein externer Fetch)',
            src.indexOf('data:image/svg+xml')===0);
    }

    // ── Test: Entscheidungsgrenze ändern verschiebt Status ──
    state = JSON.parse(JSON.stringify(fix.state));
    var fxEntCl = state.clients.find(function(c){return c.id==='fx_ent';});
    // fx_ent: tb=10. Mit Grenze 17 → ENT.
    t.assertEq('Integration','Vor Grenzen-Änderung: ENT', computeStatus(fxEntCl, fix.today).code, 'entscheidung_faellig');
    // Grenze auf 5 absenken → tb=10 nicht mehr < 5 → STABIL
    state.config.entscheidungsGrenze = 5;
    t.assertEq('Integration','Grenze 5: fx_ent nicht mehr ENT', computeStatus(fxEntCl, fix.today).code, 'stabil');
    // Zurück
    state.config.entscheidungsGrenze = 17;

    // ════════════ REGRESSION (DOM): in dieser Session behobene UI-Fehler ════════════
    var ddi = function(off){ var x=new Date(fix.today); x.setDate(x.getDate()+off); return toISO(x); };

    // [Aufnahme-Modal] kein "NaN", balancierte Divs, Footer-Button vorhanden.
    // Bug war: verirrtes unäres + (field(...) + +'<div…') → NaN-Label + kaputte Div-Schachtelung.
