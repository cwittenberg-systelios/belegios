var isAdmin = false;

function checkAdminGroup(){
  console.log('[BP-admin] checkAdminGroup() start');
  var username = (window.AJS && AJS.Meta) ? AJS.Meta.get('remote-user') : null;
  console.log('[BP-admin] AJS.Meta.get("remote-user") =', username);
  if(!username){
    console.warn('[BP-admin] kein remote-user verfügbar → isAdmin=false (Selbsttest-Panel bleibt versteckt)');
    return Promise.resolve(false);
  }
  var base = (window.AJS && AJS.contextPath) ? AJS.contextPath() : '';
  var url = base + '/rest/api/user/memberof?username=' + encodeURIComponent(username) + '&limit=200';
  console.log('[BP-admin] fetch:', url);
  return fetch(url, {
    headers: {'Accept': 'application/json'},
    credentials: 'same-origin'
  })
  .then(function(r){
    console.log('[BP-admin] HTTP', r.status, r.statusText);
    if(!r.ok) throw new Error('memberof HTTP '+r.status);
    return r.json();
  })
  .then(function(data){
    var names = (data && data.results) ? data.results.map(function(g){return g.name;}) : [];
    console.log('[BP-admin] User-Gruppen ('+names.length+'):', names);
    console.log('[BP-admin] gesuchte Admin-Gruppen:', ADMIN_GROUPS);
    var wanted = ADMIN_GROUPS.map(function(s){return s.toLowerCase();});
    var match = names.filter(function(n){ return wanted.indexOf(n.toLowerCase())!==-1; });
    var ok = match.length>0;
    console.log('[BP-admin] Match:', match, '→ isAdmin =', ok);
