function fedit(id,lbl,type,val,req){
  return '<div class="bp-field"><label for="'+id+'">'+lbl+(req?' <span class="bp-req">*</span>':'')+'</label>'+
    '<input type="'+type+'" id="'+id+'" class="bp-input" value="'+h(val||'')+'"'+dateAttrs(type)+(req?' required':'')+'>'+
    '</div>';
}

function handleEdit(clientId){
  var name=val('bp-e-name'), auf=val('bp-e-auf'), kzt=val('bp-e-kzt');
  var kzb=val('bp-e-kzb'), kzd=val('bp-e-kzd');
  var goae=document.getElementById('bp-e-goae').checked;
  var jupsy=document.getElementById('bp-e-jupsy').checked;
  var btv=val('bp-e-btv'), btnv=val('bp-e-btnv');
  var vs=val('bp-e-vs'), vb=vs!=='keine'?val('bp-e-vb'):null;
  var kue=document.getElementById('bp-e-kue').checked;
  var ed=val('bp-e-ed');
  var err={};
  if(!name||name.length<2) err['bp-e-name']='Name erforderlich';
  if(!auf) err['bp-e-auf']='Aufnahmedatum erforderlich';
  if(vs!=='keine'&&!vb) err['bp-e-vb']='Datum bei Verl\u00e4ngerung erforderlich';
  if(auf&&!dateInRange(auf)) err['bp-e-auf']=dateRangeMsg();
  if(kzb&&!dateInRange(kzb)) err['bp-e-kzb']=dateRangeMsg();
  if(vb&&!dateInRange(vb)) err['bp-e-vb']=dateRangeMsg();
  if(ed&&!dateInRange(ed)) err['bp-e-ed']=dateRangeMsg();
  if(ed&&auf&&ed<auf) err['bp-e-ed']='Entlassdatum muss nach Aufnahme liegen';
  if(Object.keys(err).length){showErr(err);return;}
  var idx=state.clients.findIndex(function(c){return c.id===clientId;});
  if(idx<0){setStatus('Klient nicht gefunden',true);return;}
  var backup=JSON.parse(JSON.stringify(state.clients[idx]));
  var editPatch={
    name:name, aufnahmedatum:auf, kostenzusage_traeger:kzt,
    kostenzusage_bis:kzb||null, kostenzusage_detail:kzd, goae:goae, jupsy:jupsy,
    bt_verbal:btv, bt_nonverbal:btnv,
    verlaengerung_status:vs, verlaengerung_bis:vb||null,
    kein_ue_gruppe:kue, entlassdatum:ed||null,
    updatedAt:new Date().toISOString()
  };
  Object.assign(state.clients[idx], editPatch);
  renderTable(state); renderBanner(state); closeModal();
  saveState(state, {replay:replaySetClientFields(clientId, editPatch, state.clients[idx])}).then(function(){setStatus('Gespeichert.');}).catch(function(e){
    state.clients[idx]=backup; renderTable(state); renderBanner(state);
    setStatus('Fehler: '+e.message,true); openEditModal(clientId);
  });
}

function handleDelete(clientId){
  var c=state.clients.find(function(x){return x.id===clientId;}); if(!c)return;
  confirm2('Klient l\u00f6schen?',
    'Soll "'+h(c.name)+'" wirklich gel\u00f6scht werden? Diese Aktion kann nicht r\u00fcckg\u00e4ngig gemacht werden.',
    'Endg\u00fcltig l\u00f6schen',true)
  .then(function(ok){
    if(!ok)return;
    var idx=state.clients.findIndex(function(x){return x.id===clientId;});
    var backup=state.clients.splice(idx,1)[0];
    renderTable(state); renderBanner(state); closeModal();
    saveState(state, {replay:replayRemoveClient(clientId)}).then(function(){setStatus(c.name+' gel\u00f6scht.');}).catch(function(e){
      state.clients.splice(idx,0,backup); renderTable(state); renderBanner(state);
      setStatus('Fehler: '+e.message,true);
    });
  });
}

